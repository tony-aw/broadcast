ndim <- ndim(x)
}
if(missing(dir.names)) {
dir.names <- dimnames(x)[[current.direction]]
}
}
if(missing(broadcaster)) {
broadcaster <- broadcaster(x)
}
# check `direction` & `ndim`:
if(!.is.natural_scalar(direction) || !.is.natural_scalar(ndim)) {
stop("if not missing, `direction` and `ndim` must be natural scalars")
}
if(direction > ndim) {
stop("`direction` cannot be larger than `ndim`")
}
# check dir.names & broadcaster:
if(!is.null(dir.names)) {
if(!is.character(dir.names) && length(dir.names) != length(x)) {
stop("improper `dir.names` given")
}
}
if(!isTRUE(broadcaster) && !isFALSE(broadcaster)) {
stop("if given, `broadcaster` must be `TRUE` or `FALSE`")
}
# MAIN FUNCTION:
