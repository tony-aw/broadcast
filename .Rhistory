ld <- function(y,i) if(is.list(y) && !is.data.frame(y)) lapply(y,ld,i+1L) else i
depths <- unlist(ld(x, 0))
hier_depths <- function(x, recurse_classed = FALSE) {
n <- hier_flatlen(x, recurse_classed) |> C_hier_clone()
out <- rep(NA_real_, n) |> C_hier_clone()
index <- C_hier_clone(0.0)
depth <- C_hier_clone(1.0)
maxdepth <- C_hier_clone(2^31 - 1L)
.rcpp_rec_depths(x, out, index, depth, maxdepth, recurse_classed)
return(out)
}
out <- hier_depths(x)
out2 <- hier_depths(x)
out
collapse::ldepth(x)
tinytest::expect_equal(
out, out2
)
hier_len_rec <- function(x, depth, n, recurse_classed = FALSE) {
return(.rcpp_hierlen(x, depth, n, recurse_classed))
}
hier_len_rec(x, 1, length(x))
lengths(x)
hier_len_rec(x, 2, sum(lengths(x)))
for(i in seq_along(x)){print(lengths(x[[i]]))}
# hier dims ====
hier_dims <- function(x, depth, recurse_classed = FALSE) {
dims <- integer(depth)
dims[1] <- length(x)
if(depth > 1) {
n <- length(x)
for(i in 2:depth) {
hierlen <- hier_len_rec(x, i - 1L, n, recurse_classed)
dims[i] <- max(hierlen)
n <- sum(hierlen)
}
}
return(dims)
}
hier_dims(x, 3)
.hiercast_prechecks <- function(x, in2out, recurse_classed, abortcall) {
if(!is.list(x)) {
stop("`x` must be a list")
}
if(length(x) == 0L) {
stop("cannot cast zero-length list")
}
if(!isTRUE(in2out) && !isFALSE(in2out)) {
stop("`in2out` must be `TRUE` or `FALSE`")
}
if(!isTRUE(recurse_classed) && !isFALSE(recurse_classed)) {
stop("`recurse_classed` must be `TRUE` or `FALSE`")
}
if(!is.null(attr(x, "class")) && !recurse_classed) {
stop("if `recurse_classed` is `FALSE`, `x` cannot be a classed list")
}
if(!.rcpp_hiercast_surface_OK(x, recurse_classed)) {
stop("not all elements have valid nested elements")
}
}
# hiercast (dynamic, for testing purposes) ====
DTYPES <- 1:16
all_for <- sprintf(
"\t for(int i%d = 0; i%d <n%d; ++i%d) {", 1:16, 1:16, 1:16, 1:16
)
txt <- paste(
"\tpart%d = i%d * pdcp[%d];",
"\tSEXP temp%d = VECTOR_ELT(temp%d, i%d);",
"\tR_xlen_t n%d = Rf_xlength(temp%d);",
sep = "\n"
)
forpart <- sprintf(
txt, 1:16, 1:16, 0:15, 1:16, 0:15, 1:16, 2:17, 1:16
)
all_for <- stri_c(all_for, forpart, sep = "\n")
cat(all_for[16])
all_parts <- sprintf("part%d", 1:16)
all_parts_decl <- sprintf("part%d", 1:16)
docode <- sprintf("SET_VECTOR_ELT(out, flatind, temp%d)", 1:16)
temp <- "
// [[Rcpp::export(rcpp_hiercast<dtype>)]]
void rcpp_hiercast<dtype>(
SEXP x, SEXP out, SEXP dcp
) {
const double *pdcp = REAL_RO(dcp);
R_xlen_t flatind;
R_xlen_t <all_parts_decl>;
SEXP temp0 = x;
R_xlen_t n1 = Rf_xlength(x);
<startfor>
flatind = <main>;
<docode>;
<endfor>
}
"
skeletons <- character(length(DTYPES))
names(skeletons) <- DTYPES
counter <- 1
for(i in DTYPES) {
current_parts_decl <- stri_c(all_parts_decl[1:i], collapse = ", ")
current_for <- stri_c(all_for[1:i], collapse = "\n")
current_main <- stri_c(all_parts[1:i], collapse = " + ")
current_docode <- docode[i]
current_end <- stri_c(rep("\t }", i), collapse = "\n")
current_fixed <- c(
"<dtype>",
"<all_parts_decl>",
"<startfor>",
"<main>",
"<docode>",
"<endfor>"
)
current_replacement <- c(
i,
current_parts_decl,
current_for,
current_main,
current_docode,
current_end
)
out <- stri_replace_all(
temp,
fixed = current_fixed,
replacement = current_replacement,
case_insensitive = FALSE,
vectorize_all = FALSE
)
skeletons[counter] <- out
counter <- counter + 1
}
cat(skeletons[[3]])
header <- "
#include <Rcpp.h>
using namespace Rcpp;
"
code <- stri_c(header, skeletons[1:16], collapse = "\n")
Rcpp::sourceCpp(code = code)
.rcpp_hiercast <- function(x, out, dcp, depth) {
funs <- list(
rcpp_hiercast1,
rcpp_hiercast2,
rcpp_hiercast3,
rcpp_hiercast4,
rcpp_hiercast5,
rcpp_hiercast6,
rcpp_hiercast7,
rcpp_hiercast8,
rcpp_hiercast9,
rcpp_hiercast10,
rcpp_hiercast11,
rcpp_hiercast12,
rcpp_hiercast13,
rcpp_hiercast14,
rcpp_hiercast15,
rcpp_hiercast16
)
funs[[depth]](x, out, dcp)
}
hiercast <- function(x, in2out = TRUE, recurse_classed = FALSE) {
.hiercast_prechecks(x, in2out, recurse_classed, sys.call())
out.ndims <- depth <- min(hier_depths(x, recurse_classed))
if(depth == 1) {
stop("not all elements have valid nested elements")
}
out.dims <- hier_dims(x, depth, recurse_classed)
if(any(out.dims == 0)) {
stop("list casting results in zero-length dimension")
}
if(in2out) {
out.dims <- rev(out.dims)
}
out.len <- prod(out.dims)
out.dcp <- c(1, cumprod(out.dims))[1:out.ndims]
if(in2out) {
# note that, when in20ut = TRUE,
# it is needed that the dimcumprod to go from large to small
# thus they need to be reversed, on top of the reversal of the dimensions themselves
out.dcp <- rev(out.dcp)
}
out <- vector("list", out.len)
dim(out) <- out.dims
.rcpp_rec_hiercast(x, out, out.dcp, 0, 1.0, depth)
return(out)
}
hiercast_dyn <- function(x, in2out = TRUE, recurse_classed = FALSE) {
.hiercast_prechecks(x, in2out, recurse_classed, sys.call())
out.ndims <- depth <- min(hier_depths(x, recurse_classed))
if(depth == 1) {
stop("not all elements have valid nested elements")
}
out.dims <- hier_dims(x, depth, recurse_classed)
if(any(out.dims == 0)) {
stop("list casting results in zero-length dimension")
}
if(in2out) {
out.dims <- rev(out.dims)
}
out.len <- prod(out.dims)
out.dcp <- c(1, cumprod(out.dims))[1:out.ndims]
if(in2out) {
# note that, when in20ut = TRUE,
# it is needed that the dimcumprod to go from small to large
# thus they need to be reversed, on top of the reversal of the dimensions themselves
out.dcp <- rev(out.dcp)
}
out <- vector("list", out.len)
dim(out) <- out.dims
.rcpp_hiercast(x, out, out.dcp, depth)
return(out)
}
