//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_hierlen)]]
SEXP rcpp_hierlen(
SEXP x, R_xlen_t depth_target, R_xlen_t n, bool recurse_classed
) {
SEXP index = PROTECT(Rf_allocVector(REALSXP, 1));
REAL(index)[0] = 0;
SEXP out = PROTECT(Rf_allocVector(REALSXP, n));
rcpp_rec_len(x, out, index, 1.0, depth_target, recurse_classed);
UNPROTECT(2);
return out;
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_hiercast_surface_OK)]]
bool rcpp_hiercast_surface_OK(
SEXP x, bool recurse_classed
) {
double n = Rf_xlength(x);
for(R_xlen_t i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(!rcpp_OK_listclass(temp, recurse_classed) || (Rf_xlength(temp) == 0)) {
return false;
}
}
return true;
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_rec_hiercast)]]
void rcpp_rec_hiercast(
SEXP x, SEXP out, SEXP dcp, int dimpart_prev, int depth, int depth_target
) {
const double dcp_current = REAL_RO(dcp)[depth - 1];
R_xlen_t dimpart_current;
R_xlen_t flatind;
if(depth == depth_target) {
for(R_xlen_t i = 0; i < Rf_xlength(x); ++i) {
dimpart_current = i * dcp_current + dimpart_prev;
SEXP temp = VECTOR_ELT(x, i);
SET_VECTOR_ELT(out, dimpart_current, temp);
}
}
else {
for(R_xlen_t i = 0; i < Rf_xlength(x); ++i) {
dimpart_current = i * dcp_current + dimpart_prev;
SEXP temp = VECTOR_ELT(x, i);
rcpp_rec_hiercast(temp, out, dcp, dimpart_current, depth + 1, depth_target);
}
}
}
"
Rcpp::sourceCpp(code = code)
x <- list(
list(list(list(list(1L)))),
as.list(1:10),
list(list(list())),
list(list(NULL)),
data.frame(letters)
)
dropnests <- function(x, recurse_classed = FALSE) {
if(!is.list(x)) {
stop("`x` must be a list")
}
return(.rcpp_dropnests(x, recurse_classed))
}
dropnests(x)
dropnests(x, recurse_classed = TRUE)
out <- dropnests(x)
out2 <- dropnests(x)
tinytest::expect_equal(
out, out2
)
