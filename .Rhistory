# in C:
body <- "
const int *pxdim = INTEGER_RO(xdim);
const int *pydim = INTEGER_RO(ydim);
int n = Rf_length(xdim);
int counter = 0;
for(int i = 0; i < n; ++i) {
if(pxdim == 1 && pydim == 1) {
counter++;
}
}
return asScalarInteger(counter);
"
C_dropdims_count <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP"))
C_dropdims_count <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP"), body)
# in C:
body <- "
const int *pxdim = INTEGER_RO(xdim);
const int *pydim = INTEGER_RO(ydim);
int n = Rf_length(xdim);
int counter = 0;
for(int i = 0; i < n; ++i) {
if(pxdim == 1 && pydim == 1) {
counter++;
}
}
return Rf_ScalarInteger(counter);
"
C_dropdims_count <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP"), body)
# in C:
body <- "
const int *pxdim = INTEGER_RO(xdim);
const int *pydim = INTEGER_RO(ydim);
int n = Rf_length(xdim);
int counter = 0;
for(int i = 0; i < n; ++i) {
if(pxdim[i] == 1 && pydim[i] == 1) {
counter++;
}
}
return Rf_ScalarInteger(counter);
"
C_dropdims_count <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP"), body)
C_dropdims_which <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP", size = "SEXP"), body)
C_dropdims_which <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP", size = "SEXP"), body_which)
body_which <- "
const int *pxdim = INTEGER_RO(xdim);
const int *pydim = INTEGER_RO(ydim);
int n = Rf_length(xdim);
int size0 = INTEGER(size)[0];
SEXP out = PROTECT(Rf_allocVector(INTSXP, size0))
int *pout = INTEGER(out);
int counter = 0;
for(int i = 0; i < n; ++i) {
if(pxdim[i] == 1 && pydim[i] == 1) {
pout[counter] = i + 1;
counter++;
}
}
UNPROTECT(1);
return out;
"
C_dropdims_which <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP", size = "SEXP"), body_which)
body_which <- "
const int *pxdim = INTEGER_RO(xdim);
const int *pydim = INTEGER_RO(ydim);
int n = Rf_length(xdim);
int size0 = INTEGER(size)[0];
SEXP out = PROTECT(Rf_allocVector(INTSXP, size0));
int *pout = INTEGER(out);
int counter = 0;
for(int i = 0; i < n; ++i) {
if(pxdim[i] == 1 && pydim[i] == 1) {
pout[counter] = i + 1;
counter++;
}
}
UNPROTECT(1);
return out;
"
C_dropdims_which <- inline::cfunction(signature(xdim = "SEXP", ydim = "SEXP", size = "SEXP"), body_which)
x.dim <- c(2, 1, 5, 1, 5)
y.dim <- c(5, 1, 3, 2, 1)
C_dropdims_count(x.dim, y.dim)
x.dim <- c(2, 1, 5, 1, 5) |> as.integer()
y.dim <- c(5, 1, 3, 2, 1) |> as.integer()
C_dropdims_count(x.dim, y.dim)
x.dim <- c(2, 1, 5, 1, 5, 1) |> as.integer()
y.dim <- c(5, 1, 3, 2, 1, 1) |> as.integer()
C_dropdims_count(x.dim, y.dim)
n <- C_dropdims_count(x.dim, y.dim)
C_dropdims_which(x.dim, y.dim, n)
