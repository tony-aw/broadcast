return(rcpp_checkmissing_which32(x, inv, count))
}
else {
return(rcpp_checkmissing_which64(x, inv, count))
}
}
else {
stop("unsupported operator given")
}
}
# is.na tests ====
x <- sample(c(1:10, NA), 100, TRUE)
tinytest::expect_equal(
checkmissing(x, "logical", FALSE),
is.na(x)
)
tinytest::expect_equal(
checkmissing(x, "logical", TRUE),
!is.na(x)
)
tinytest::expect_equal(
checkmissing(x, "raw", FALSE),
as.raw(is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "raw", TRUE),
as.raw(!is.na(x))
)
# any/all tests ====
tinytest::expect_equal(
checkmissing(x, "any", FALSE),
any(is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "all", FALSE),
all(is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "any", TRUE),
any(!is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "all", TRUE),
all(!is.na(x))
)
# count tests ====
tinytest::expect_equal(
checkmissing(x, "count", FALSE),
sum(is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "count", TRUE),
sum(!is.na(x))
)
# which tests ====
tinytest::expect_equal(
checkmissing(x, "which", FALSE),
which(is.na(x))
)
tinytest::expect_equal(
checkmissing(x, "which", TRUE),
which(!is.na(x))
)
