x <- matrix(as.double(1:100), 1, 2000)
y <- matrix(as.double(1:100), 2000, 1)
x.dim <- c(dim(x), rep(1L, 14))
y.dim <- c(dim(y), rep(1L, 14))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <- broadcast:::.C_make_dcp(y.dim)
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 16 - length(out.dim)))
out.len <- prod(out.dim)
rcpp_plus_static(
x, y,
dcp_x, dcp_y, by_x, by_y, out.len, out.dim, 2L
)
bc.d(x, y, "+") |> as.vector()
foo <- bench::mark(
bc = bc.d(x, y, "+"),
static = rcpp_plus_static(
x, y,
dcp_x, dcp_y, by_x, by_y, out.len, out.dim, 2L
),
check = FALSE, # because dimension difference
min_iterations = 500
)
summary(foo)
plot(foo)
