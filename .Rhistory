# hier dims (cumulative approach) ====
code_cum <- "
#include <Rcpp.h>
using namespace Rcpp;
bool rcpp_OK_listclass(
SEXP x, bool ignore_classed
) {
if(TYPEOF(x) != VECSXP) {
return false;
}
if(!ignore_classed) {
return true;
}
return (Rf_getAttrib(x, R_ClassSymbol) == R_NilValue);
}
// [[Rcpp::export(rcpp_lst_len_rec)]]
void rcpp_lst_len_rec(
SEXP x, SEXP out, SEXP index, int depth, int depth_target, bool ignore_classed
) {
int n = Rf_xlength(x);
for(int i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(depth == depth_target) {
SET_REAL_ELT(out, REAL(index)[0], Rf_xlength(temp));
SET_REAL_ELT(index, 0, REAL(index)[0] + 1);
}
else if(rcpp_OK_listclass(temp, ignore_classed) && depth != depth_target && Rf_xlength(temp) != 0) {
rcpp_lst_len_rec(temp, out, index, depth + 1, depth_target, ignore_classed);
}
}
}
"
Rcpp::cppFunction(code_cum)
x <- list(
list(as.list(1:10)),
list(as.list(1:9)),
list(1:11),
list(list()),
list(list(NULL)),
data.frame(letters, LETTERS)
)
hier_len_rec(x, 1)
# hiercast (dynamic) ====
DTYPES <- 1:16
all_for <- sprintf(
"\t for(int i%d = 0; i%d <n%d; ++i%d) {", 1:16, 1:16, 1:16, 1:16
)
txt <- paste(
"\tpart%d = i%d * pdcp[%d];",
"\tSEXP temp%d = VECTOR_ELT(temp%d, i%d);",
"\tR_xlen_t n%d = Rf_xlength(temp%d);",
sep = "\n"
)
forpart <- sprintf(
txt, 1:16, 1:16, 0:15, 1:16, 0:15, 1:16, 2:17, 1:16
)
all_for <- stri_c(all_for, forpart, sep = "\n")
cat(all_for[16])
all_parts <- sprintf("part%d", 1:16)
