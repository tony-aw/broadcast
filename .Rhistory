# speed tests
library(broadcast)
n <- 31L
print(n^4 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, n, 1L, 1L)
npb <- np$random$rand(1L,1L, n, n)
a <- array(rnorm(100), c(n, n, 1L, 1L))
b <- array(rnorm(100), c(1L,1L, n, n))
broadcaster(a) <- broadcaster(b) <- TRUE
