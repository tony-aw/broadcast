x.dim[direction] <- length(x)
x.dimnames <- rep(list(NULL), ndim)
x.dimnames[[direction]] <- dir.names
dim(x) <- x.dim
dimnames(x) <- x.dimnames
broadcaster(x) <- broadcaster
return(x)
}
