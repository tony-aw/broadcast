x <- 1:10
y <- 1:10
dim(x) <- c(10, 1)
library(squarebrackets)
x <- as.mutatomic(x)
y <- as.mutatomic(y)
dim(x) <- c(10, 1)
dim(y) <- c(1, 10)
broadcaster(x) <- TRUE
broadcaster(y) <- TRUE
library(broadcast)
broadcaster(x) <- TRUE
broadcaster(y) <- TRUE
x + y / x
(x + y) / x
(x + y) * x
# relational operators ====
x <- 1:10
y <- array(1:10, c(1, 10))
broadcaster(x) <- TRUE
broadcaster(y) <- TRUE
x <- as.mutatomic(x)
x
y <- as.mutatomic(y)
broadcaster(x) <- TRUE
broadcaster(y) <- TRUE
x == y
x != y
x < y
x > y
x <= y
x >= y
class(x)
class(y)
x <- 1:10
y <- 1:10
dim(x) <- c(10, 1)
dim(y) <- c(1, 10)
broadcaster(x) <- TRUE
broadcaster(y) <- TRUE
class(x)
x <- as.mutatomic(x)
class(x)
x <- mutatomic(1:10)
broadcaster(x) <- TRUE
class(x)
