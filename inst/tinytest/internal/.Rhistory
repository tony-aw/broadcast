# set-up ====
enumerate <- 0L
errorfun <- function(tt) {
if(isTRUE(tt)) print(tt)
if(isFALSE(tt)) stop(print(tt))
}
mergeable <- broadcast:::.rcpp_is_mergeable_with_prev
mergedims <- broadcast:::.rcpp_mergedims
for(i in 1:8) {
pow <- 1/(i * 2)
n <- ceiling(1e6^pow) |> as.integer()
x.dim <- rep(c(1L, n), i)
y.dim <- rep(c(n, 1L), i)
m <- mergeable(x.dim, y.dim, x.dim == 1L, y.dim == 1L)
expect_equal(
list(x.dim, y.dim),
mergedims(x.dim, y.dim, m)
) |> errorfun()
x.dim <- rep(c(1L, n), i)
y.dim <- rep(c(n, 1L), i)
m <- mergeable(y.dim, x.dim, y.dim == 1L, x.dim == 1L)
expect_equal(
list(y.dim, x.dim),
mergedims(y.dim, x.dim, m)
) |> errorfun()
}
n <- 10
# check int overflow safety ====
n <- 2^31 - 1
# check int overflow safety ====
n <- 2^31 - 1
x.dim <- c(n, n, 1)
y.dim <- c(1, 1, n)
# check int overflow safety ====
n <- as.integer(2^31 - 1)
x.dim <- c(n, n, 1)
y.dim <- c(1, 1, n)
m <- mergeable(x.dim, y.dim, x.dim == 1L, y.dim == 1L)
