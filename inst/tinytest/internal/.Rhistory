expect_equal(
list(x.dim, y.dim),
mergedims(x.dim, y.dim, m)
) |> errorfun()
x.dim <- c(n, 1L, 1L)
y.dim <- c(1L, n, n)
m <- mergeable(x.dim, y.dim, x.dim == 1L, y.dim == 1L)
expect_equal(
