install.packages("broadcast")
library(broadcast)
input <- rbind(c(0), c(1), c(0))
input = t(as.matrix(input))
x = broadcast::bind_array(list(input, input), along = 3)
x = x == 1
x = x[, , 1] + x[, , 2]
dim(x) <- dim(input)
message("This is the result in:")
message(as.character(packageVersion("broadcast")))
print(rowSums(as.matrix(pmin(x, 2))))
broadcaster(x) <- TRUE
pmin(x, 2)
pmin
is.object(x)
unclass(x)
unclass(x) |> is.object(x)
unclass(x) |> is.object()
rep(x, 2)
rep(x, length.out = 3)
x
x > 2
broadcaster(x) <- FALSE
x > 2
broadcaster(x) <- TRUE
x[x]
elts <- list(x, 2)
mmm <- elts[[1L]]
has.na <- FALSE
as <- methods::as
asL <- function(x) if (isS4(x))
as(x, "logical")
else x
broadcaster(x) <- TRUE
x
elts <- list(x, 2)
mmm <- elts[[1L]]
has.na <- FALSE
as <- methods::as
asL <- function(x) if (isS4(x))
as(x, "logical")
else x
asL <- function(x) {
if (isS4(x)) as(x, "logical")
else x
}
each = elts[-1]
each = elts[-1][[1]]
l1 <- length(each)
l2 <- length(mmm)
l2 && (l2 < l1 || !l1)
l1 && (l1 < l2 || !l2)
each <- rep(each, length.out = l2)
na.m <- is.na(mmm)
na.e <- is.na(each)
has.na || (has.na <- any(na.m) || any(na.e))
nS4 <- !isS4(mmm)
isS4(change <- mmm > each) && (nS4 || !isS4(each))
change
change & !is.na(change)
mmm
each
mmm > each
