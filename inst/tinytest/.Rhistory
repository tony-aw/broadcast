# Chunk 1
library(squarebrackets)
# Chunk 2
x <- 1:20
names(x) <- c(letters[1:10], letters[1:10])
ii_x(x, 1) # extract first element
ii_x(x, 10) # extract 10th element
ii_x(x, 2:5) # extract elements 2 to 5
ii_x(x, c(3, 5, 6)) # extract elements 3, 5, 6
ii_x(x, x > 5L) # extract all elements for which x > 5
ii_x(x, "a") # extract element whose name is "a"
ii_x(x, c("a", "b")) # extract element whose name is "a" or "b"
# Chunk 3
is_even <- function(x) x %% 2 == 0
ii_x(x, is_even) # extract even numbers
# Chunk 1
library(squarebrackets)
# Chunk 2
x <- 1:20
names(x) <- c(letters[1:10], letters[1:10])
ii_x(x, 1) # extract first element
ii_x(x, 10) # extract 10th element
ii_x(x, 2:5) # extract elements 2 to 5
ii_x(x, c(3, 5, 6)) # extract elements 3, 5, 6
ii_x(x, x > 5L) # extract all elements for which x > 5
ii_x(x, "a") # extract element whose name is "a"
ii_x(x, c("a", "b")) # extract element whose name is "a" or "b"
# Chunk 3
print(x) # original vector
ii_x(x, 1:5, -1) # exclude first 5 elements
ii_x(x, "a", -1) # exclude *all* elements with name "a"
ii_x(x, x > 5, -1) # exclude elements where x > 5
# Chunk 4
ii_x(x, rep(1L, 10L)) # repeat first element 10 times
ii_x(x, rep("a", 10L)) # repeat element *all* elements with name "a" 10 times
# Chunk 5
ii_x(x, c(10L, 1L)) # extract elements 1 and 10, and swap their order
ii_x(x, c("b", "a")) # extract all elements with name "a" or "b", in order {"b", "a"}
x <- 1:20
names(x) <- c(letters[1:10], letters[1:10])
ii_mod(x, is_even, rp = -1)
x <- 1:20
names(x) <- c(letters[1:10], letters[1:10])
ii_mod(x, x > 5, rp = -1)
print(x) # x is modified
ii_mod(x, 1:5, rp = 1:6)
x <- 1:20
names(x) <- c(letters[1:10], letters[1:10])
ii_mod(x, x > 5, tf = sqrt)
print(x)
