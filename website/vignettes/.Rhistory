?mgcv::gamSim
d <- mgcv::gamSim(7, n = 400L, dist = "normal", scale = 2L)
m <- mgcv::gam(y ~ s(x1) + s(x2) + s(x3), data = d)
par(mfrow = c(1,1))
plot(m, select = 2)
# get names of relevant coefficients:
coeffnames <- names(coef(m))
coeffnames <- coeffnames[grepl("x2", coeffnames)]
# get necessary model parameters (i.e. X, b, vc)
# but only for relevant coefficients:
b <- coef(m)[coeffnames] # coefficients
X <- predict(m, type="lpmatrix")[, coeffnames, drop = FALSE] # model matrix
vc <- vcov(m)[coeffnames, coeffnames, drop = FALSE]
means <- X %*% b
# mgcv uses a multiplier of 2
# which is very close to the multiplier for a 95% confidence interval
st.devs <- sd_gauss_lc(X, vc)
lower <- means - 2 * st.devs
upper <- means + 2 * st.devs
library(broadcast)
# mgcv uses a multiplier of 2
# which is very close to the multiplier for a 95% confidence interval
st.devs <- sd_gauss_lc(X, vc)
lower <- means - 2 * st.devs
upper <- means + 2 * st.devs
# original plot:
par(mfrow = c(1,1))
plot(m, select = 2)
# our own re-creation plotted over it:
lincomb <- data.frame(
x = d$x2,
means = means,
lower = lower,
upper = upper
)
lincomb <- lincomb[order(lincomb$x),]
points(
x = lincomb$x,
y = lincomb$mean,
col = "red"
)
points(
x = lincomb$x,
y = lincomb$lower,
col = "pink"
)
points(
x = lincomb$x,
y = lincomb$upper,
col = "pink"
)
# get names of relevant coefficients:
coeffnames <- names(coef(m))
coeffnames <- coeffnames[grepl("(Intercept)|x2", coeffnames)]
# get necessary model parameters (i.e. X, b, vc)
# but only for relevant coefficients:
b <- coef(m)[coeffnames] # coefficients
X <- predict(m, type="lpmatrix")[, coeffnames, drop = FALSE] # model matrix
vc <- vcov(m)[coeffnames, coeffnames, drop = FALSE]
means <- X %*% b - b[1]
# mgcv uses a multiplier of 2
# which is very close to the multiplier for a 95% confidence interval
st.devs <- sd_gauss_lc(X, vc)
lower <- means - 2 * st.devs
upper <- means + 2 * st.devs
# original plot:
par(mfrow = c(1,1))
plot(m, select = 2)
# our own re-creation plotted over it:
lincomb <- data.frame(
x = d$x2,
means = means,
lower = lower,
upper = upper
)
lincomb <- lincomb[order(lincomb$x),]
points(
