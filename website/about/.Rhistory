.rcpp_hiercast <- function(x, out, dcp, depth) {
funs <- list(
rcpp_hiercast1,
rcpp_hiercast2,
rcpp_hiercast3,
rcpp_hiercast4,
rcpp_hiercast5,
rcpp_hiercast6,
rcpp_hiercast7,
rcpp_hiercast8,
rcpp_hiercast9,
rcpp_hiercast10,
rcpp_hiercast11,
rcpp_hiercast12,
rcpp_hiercast13,
rcpp_hiercast14,
rcpp_hiercast15,
rcpp_hiercast16
)
funs[[depth]](x, out, dcp)
}
hiercast <- function(x, in2out = TRUE) {
out.ndims <- depth <- min(hier_depths(x))
out.dims <- c(
length(x),
max(lengths(x)),
max(hier_len_rec(x, 2))
)
if(in2out) {
out.dims <- rev(out.dims)
}
out.len <- prod(out.dims)
out.dcp <- c(1, cumprod(out.dims))[1:out.ndims]
if(in2out) {
# note that, when in20ut = TRUE,
# it is needed that the dimcumprod to go from small to large
# thus they need to be reversed, on top of the reversal of the dimensions themselves
out.dcp <- rev(out.dcp)
}
out <- vector("list", out.len)
dim(out) <- out.dims
.rcpp_hiercast(x, out, out.dcp, depth)
return(out)
}
