named = bc.d(x2, y2, "+"),
min_iterations = 100,
check = FALSE
)
bm_names_vectors <- bench::mark(
unnamed = bc.d(x, y, "+"),
named = bc.d(x2, y2, "+"),
min_iterations = 100,
check = FALSE
)
summary(bm_names_vectors)
plot(bm_names_vectors)
