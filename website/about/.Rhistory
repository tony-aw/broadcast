# operator-related:
?broadcast::broadcast_operators
?broadcast::bc.rel()
?atomic
?recursive
?is.atomic
# set-up ====
library(broadcast)
# arrays
n <- 400
x <- x2 <- array(rnorm(100), c(n, 1, n))
y <- y2 <- array(rnorm(100), c(1, n, 1))
dimnames(x2) <- lapply(dim(x2), \(m) sample(letters, m, TRUE))
dimnames(y2) <- lapply(dim(y2), \(m) sample(letters, m, TRUE))
bm_names_arrays <- bench::mark(
bc.d(x, y, "+"),
bc.d(x2, y2, "+"),
min_iterations = 100,
check = FALSE
)
summary(bm_names_arrays)
plot(bm_names_arrays)
# array and vector ====
n <- 400
x <- x2 <- array(rnorm(100), c(n, 1, n))
y <- y2 <- rnorm(n)
dimnames(x2) <- lapply(dim(x2), \(m) sample(letters, m, TRUE))
names(y2) <- sample(letters, m, TRUE)
names(y2) <- sample(letters, n, TRUE)
bm_names_arrays <- bench::mark(
unnamed = bc.d(x, y, "+"),
named = bc.d(x2, y2, "+"),
min_iterations = 100,
check = FALSE
)
# array and vector ====
n <- 400
x <- x2 <- array(rnorm(100), c(n, 1, n))
y <- y2 <- rnorm(n)
dimnames(x2) <- lapply(dim(x2), \(m) sample(letters, m, TRUE))
names(y2) <- sample(letters, n, TRUE)
bm_names_av <- bench::mark(
unnamed = bc.d(x, y, "+"),
named = bc.d(x2, y2, "+"),
min_iterations = 100,
check = FALSE
)
summary(bm_names_av)
plot(bm_names_av)
# array and vector ====
