df2 <- data.frame(
q1_bc, q1_np, i = 2:8
)
df2 <- tidyr::pivot_longer(df2, 1:2, values_to = "q1")
df3 <- data.frame(
q3_bc, q3_np, i = 2:8
)
df3 <- tidyr::pivot_longer(df3, 1:2, values_to = "q3")
