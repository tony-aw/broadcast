n <- 1e6
x <- x2 <- rnorm(n)
y <- y2 <- rnorm(n)
dimnames(x2) <- sample(letters, n, TRUE)
names(x2) <- sample(letters, n, TRUE)
names(y2) <- sample(letters, n, TRUE)
