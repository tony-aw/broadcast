n <- 100
w <- matrix(rnorm(n), 1, n)
vc <- matrix(rnorm(n), n, n)
gc()
bm_la <- bench::mark(
sqrt(t(w) %*% vc %*%),
bm_la <- bench::mark(
sqrt(t(w) %*% vc %*% w),
sd_gauss_lc(w, vc),
min_iterations = 100
)
