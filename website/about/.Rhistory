op <- ops[[i]]
x <- datagens[[i]]()
y <- datagens[[i]]()
if(iDimX) dim(x) <- length(x)
dim(y) <- c(1, length(y))
expect_equal(
funs[[i]](x, y, op) |> names(),
NULL
) |> errorfun()
expect_equal(
funs[[i]](y, x, op) |> names(),
NULL
) |> errorfun()
enumerate <- enumerate + 2L
}
}
