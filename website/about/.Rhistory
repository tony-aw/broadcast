module <- df$name
tinytheme("minimal")
tinyplot(
df$i, df$median*1000, by = module, type = "l",
main = "benchmarks",
xlab = "number of dimensions",
ylab = "median time (ms)"
)
tinyplot_add(
min = df$q1*1000, ymax = df$q3*1000, by = module,
type = type_ribbon(alpha = 0.25)
)
