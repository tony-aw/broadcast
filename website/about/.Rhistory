.binary_determine_out.dim <- function(x.dim, y.dim, x.ndim, y.ndim, abortcall) {
if(x.ndim == 0L && y.ndim == 0L) {
return(NULL)
}
else if(x.ndim != 0L && y.ndim != 0L) {
out.ndim <- max(x.ndim, y.ndim)
out.dim <- C_make_outdim(x.dim, y.dim, out.ndim)
out.len <- prod(out.dim)
if(broadcast:::.C_arraysize_overflow(out.dim, out.len)){
stop(simpleError("broadcasting will exceed maximum size", call = abortcall))
}
return(out.dim)
}
else if(!is.null(x.dim)) {
return(x.dim)
}
else {
return(y.dim)
}
}
body <- "
const int *restrict px = INTEGER_RO(x);
const int *restrict py = INTEGER_RO(y);
const int n = INTEGER_RO(ndim)[0];
SEXP out = PROTECT(Rf_allocVector(INTSXP, n));
int *pout;
pout = INTEGER(out);
for(int i = 0; i < n; ++i) {
if(px[i] > py[i]) {
pout[i] = px[i];
}
else {
pout[i] = py[i];
}
}
UNPROTECT(1);
return(out);
"
C_make_outdim <- inline::cfunction(
signature(x = "SEXP", y = "SEXP", ndim = "SEXP"),
body,
language = "C"
)
cat(C_make_outdim@code)
# test equal lens
x <- sample(1:10)
y <- sample(1:10)
tinytest::expect_equal(
C_make_outdim(x, y, 10L),
pmax(x, y)
)
# test len(x) > len(y)
x <- c(sample(1:10, 6), rep(1L, 4))
y <- sample(1:10, 6)
tinytest::expect_equal(
C_make_outdim(x, y, 6L),
pmax(x[1:6], y)
)
# test len(x) < len(y)
x <- sample(1:10, 6)
y <- c(sample(1:10, 6), rep(1L, 4))
tinytest::expect_equal(
C_make_outdim(x, y, 6L),
pmax(x, y[1:6])
)
body <- "
int nx = Rf_length(x);
if(nx > 16) {
error(\"only arrays up to 16 dimensions are supported\");
}
SEXP out = PROTECT(Rf_allocVector(INTSXP, 16));
int *pout = INTEGER(out);
if(nx == 0) {
for(int i = 0; i < 16; ++i) {
pout[i] = 1;
}
UNPROTECT(1);
return out;
}
int *px = INTEGER(x);
if(nx == 16) {
for(int i = 0; i < 16; ++i) {
pout[i] = px[i];
}
UNPROTECT(1);
return out;
}
if(nx < 16) {
for(int i = 0; i < nx; ++i) {
pout[i] = px[i];
}
for(int i = nx; i < 16; ++i) {
pout[i] = 1;
}
UNPROTECT(1);
return out;
}
"
C_virt_allocdim <- inline::cfunction(
signature(x = "SEXP"),
body,
language = "C"
)
cat(C_virt_allocdim@code)
# test len 0
x <- NULL
tinytest::expect_equal(
C_virt_allocdim(x),
rep(1L, 16L)
)
# test len < 16
x <- sample(1:10)
tinytest::expect_equal(
C_virt_allocdim(x),
c(x, rep(1L, 16 - length(x)))
)
# test len == 16
x <- sample(1:16)
tinytest::expect_equal(
C_virt_allocdim(x),
x
)
tinytest::expect_true(
data.table::address(x) != data.table::address(C_virt_allocdim(x))
)
x <- sample(1:10)
n <- 500
foo <- bench::mark(
base = for(i in 1:n) c(x, rep(1L, 16L - length(x))),
virt = for(i in 1:n) C_virt_allocdim(x),
min_iterations = n
)
summary(foo)
plot(foo)
