n <- floor(target_len^(1/ndim)) # floor to allow easy correction later
if(start1) {
out <- rep(c(1L, n), ndim)[1:ndim]
}
else {
out <- rep(c(n, 1L), ndim)[1:ndim]
}
# adjust last non-1 size to ensure target len is correct:
