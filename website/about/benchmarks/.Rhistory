# nested vs dimensional list ====
x <- lapply(1:100, function(x) sample(1:100))
x <- rep(list(x), 100)
x2 <- cast_hier2dim(x)
library(broadcast)
x2 <- cast_hier2dim(x)
dim(x)
dim(x2)
bm_hier_vs_dim <- bench::mark(
for(i in 1:length(x)) x[[i]][[1L]],
x[1L, drop = FALSE],
min_iterations = 100
)
bm_hier_vs_dim <- bench::mark(
for(i in 1:length(x)) x[[i]][[1L]],
x[1L, drop = FALSE],
min_iterations = 100,
check = FALSE
)
summary(bm_hier_vs_dim)
plot(bm_hier_vs_dim)
bm_hier_vs_dim <- bench::mark(
for(i in 1:length(x)) x[[i]][[1L]],
x[1L, drop = FALSE],
min_iterations = 200,
check = FALSE
)
summary(bm_hier_vs_dim)
plot(bm_hier_vs_dim)
