# base sweep ====
n <- 2000
x <- matrix(rnorm(n), n, n)
cm <- array(colMeans(x), c(1, n))
gc()
bm_sweep <- bench::mark(
sweep = sweep(x, 2, cm, "=="),
broadcast = bc.d(x, cm, "=="),
min_iterations = 100
)
summary(bm_sweep)
plot(bm_sweep)
save(bm_sweep, file = "bm_sweep.RData")
