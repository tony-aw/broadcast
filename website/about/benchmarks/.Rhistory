# set-up ====
library(broadcast)
get_times <- function(obj) {
# remove calls with > 0 GC:
idx <- rowSums(obj$gc[[1L]][, 2:3]) == 0
times <- obj$time[[1L]][idx]
# exclude first 10 for warm up:
times <- times[-1:-10]
return(times)
}
# loop 2d ====
