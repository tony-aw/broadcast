bc = for (i in 1:100) {
bc.d(a, b, "+")
},
internal_main = for(i in 1:100) {
broadcast:::.rcpp_bc_dec_d(a, b, by_a, by_b, dcp_a, dcp_b, out.dim, out.len, 1L)
},
naming = for(i in 1:100) {
broadcast:::.binames_set(a, b, out)
},
`numpy (no conversion to R)` = for(i in 1:100) {
npa + npb
},
for(i in 1:00) as.vector(a) + as.vector(b),
check = FALSE,
min_iterations = 10,
)
summary(foo)
ggplot2::autoplot(foo)
# speed tests
library(broadcast)
n <- 20L
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
timeit <- rt$import("timeit", convert = FALSE)
npa <- np$random$rand(n, 1L, n)
npb <- np$random$rand(n, n, 1L)
npa + npb
a <- array(rnorm(100), c(n, 1L, n))
# dimnames(a) <- list(letters[1:n], NULL, letters[1:n])
a.dim <- dim(a)
b <- array(rnorm(100), c(n, n, 1))
# dimnames(b) <- list(LETTERS[1:n], LETTERS[1:n], NULL)
b.dim <- dim(b)
by_a <- ifelse(dim(a) > 1L, 1L, 0L)
by_b <- ifelse(dim(b) > 1L, 1L, 0L)
s_a <- list(1:n, 1:n, 1:n)
s_b <- list(1:n, 1:n, rep(1L, n))
dcp_a <- c(1, cumprod(dim(a)))
dcp_b <- c(1, cumprod(dim(b)))
out.dim <- pmax(dim(a), dim(b))
out.len <- prod(out.dim)
out <- bc.d(a, b, "+")
foo <- bench::mark(
bc = for (i in 1:100) {
bc.d(a, b, "+")
},
internal_main = for(i in 1:100) {
broadcast:::.rcpp_bc_dec_d(a, b, by_a, by_b, dcp_a, dcp_b, out.dim, out.len, 1L)
},
naming = for(i in 1:100) {
broadcast:::.binames_set(a, b, out)
},
`numpy (no conversion to R)` = for(i in 1:100) {
npa + npb
},
for(i in 1:00) as.vector(a) + as.vector(b),
check = FALSE,
min_iterations = 10,
)
summary(foo)
ggplot2::autoplot(foo)
