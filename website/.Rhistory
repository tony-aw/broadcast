# WRITE RCPP ====
header <- "
#include <Rcpp/Lightest>
using namespace Rcpp;
"
macro_old <- "
#define MACRO_DIM_OLD(DOCODE) do {      \\
R_xlen_t flatind_out = 0;         \\
const int *pby_x = INTEGER_RO(by_x);        \\
const int *pby_y = INTEGER_RO(by_y);        \\
const double *pdcp_x = REAL_RO(dcp_x);        \\
const double *pdcp_y = REAL_RO(dcp_y);        \\
const int N1 = INTEGER_RO(out_dim)[0];	\\
const int N2 = INTEGER_RO(out_dim)[1];	\\
const int N3 = INTEGER_RO(out_dim)[2];	\\
const int N4 = INTEGER_RO(out_dim)[3];	\\
\\
R_xlen_t flatind_x;       \\
R_xlen_t flatind_y;       \\
R_xlen_t i_x2, i_x3, i_x4; \\
R_xlen_t i_y2, i_y3, i_y4; \\
for(int iter4 = 0; iter4 <N4; ++iter4) {	\\
i_x4 = pby_x[3] * iter4 * pdcp_x[3];	\\
i_y4 = pby_y[3] * iter4 * pdcp_y[3];	\\
for(int iter3 = 0; iter3 <N3; ++iter3) {	\\
i_x3 = pby_x[2] * iter3 * pdcp_x[2] + i_x4;	\\
i_y3 = pby_y[2] * iter3 * pdcp_y[2] + i_y4;	\\
for(int iter2 = 0; iter2 <N2; ++iter2) {	\\
i_x2 = pby_x[1] * iter2 * pdcp_x[1] + i_x3;	\\
i_y2 = pby_y[1] * iter2 * pdcp_y[1] + i_y3;	\\
for(int iter1 = 0; iter1 <N1; ++iter1) {	\\
\\
\\
flatind_x = pby_x[0] * iter1 + i_x2;       \\
flatind_y = pby_y[0] * iter1 + i_y2;     \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
} while(0)
"
macro_new <- "
#define MACRO_DIM_NEW(DOCODE) do {      \\
R_xlen_t flatind_out = 0;         \\
const long long *pstride_x = stride_x.data();        \\
const long long *pstride_y = stride_y.data();        \\
const int N1 = INTEGER_RO(out_dim)[0];	\\
const int N2 = INTEGER_RO(out_dim)[1];	\\
const int N3 = INTEGER_RO(out_dim)[2];	\\
const int N4 = INTEGER_RO(out_dim)[3];	\\
\\
R_xlen_t flatind_x;       \\
R_xlen_t flatind_y;       \\
R_xlen_t i_x2, i_x3, i_x4; \\
R_xlen_t i_y2, i_y3, i_y4; \\
for(int iter4 = 0; iter4 <N4; ++iter4) {	\\
i_x4 = pstride_x[3] * iter4;	\\
i_y4 = pstride_y[3] * iter4;	\\
for(int iter3 = 0; iter3 <N3; ++iter3) {	\\
i_x3 = pstride_x[2] * iter3;	\\
i_y3 = pstride_y[2] * iter3;	\\
for(int iter2 = 0; iter2 <N2; ++iter2) {	\\
i_x2 = pstride_x[1] * iter2;	\\
i_y2 = pstride_y[1] * iter2;	\\
for(int iter1 = 0; iter1 <N1; ++iter1) {	\\
\\
\\
flatind_x = pstride_x[0] * iter1 + i_x2 + i_x3 + i_x4;       \\
flatind_y = pstride_y[0] * iter1 + i_y2 + i_y3 + i_y4;     \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
} while(0)
"
fun_old <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_old, rng = false)]]
SEXP rcpp_bc_dec_old(
SEXP x, SEXP y,
SEXP by_x,
SEXP by_y,
SEXP dcp_x, SEXP dcp_y, SEXP out_dim, R_xlen_t nout
) {
double tempout;
SEXP out = PROTECT(Rf_allocVector(REALSXP, nout));
double *pout;
pout = REAL(out);
const int *px = INTEGER_RO(x);
const int *py = INTEGER_RO(y);;
MACRO_DIM_OLD(px[flatind_x] + py[flatind_y]);
UNPROTECT(1);
return out;
}
"
fun_new <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_new, rng = false)]]
SEXP rcpp_bc_dec_new(
SEXP x, SEXP y,
const std::vector<long long> stride_x,
const std::vector<long long> stride_y,
SEXP out_dim, R_xlen_t nout
) {
double tempout;
SEXP out = PROTECT(Rf_allocVector(REALSXP, nout));
double *pout;
pout = REAL(out);
const int *px = INTEGER_RO(x);
const int *py = INTEGER_RO(y);
MACRO_DIM_NEW(px[flatind_x] + py[flatind_y]);
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = paste0(header, macro_old, fun_old, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, macro_new, fun_new, collapse = "\n"))
