print(unclass(x))
}
.bi
is.ikw.bilateral <- function(x) {
if(!inherits(x, "ikw.bilateral")) return(FALSE)
if(!is.numeric(x) && !is.list(x)) return(FALSE)
return(TRUE)
}
.bi <- ikw.bilateral(list(NULL))
.bi
.op.ikw.bilateral <- function(e1, e2, op) {
if(is.list(e1) && is.list(e2)) {
stop("cannot multiply `.bi` with itself")
}
if(!is.list(e1) && !is.list(e2)) {
e1 <- unclass(e1)
e2 <- unclass(e2)
out <- op(e1, e2)
return(ikw.bilateral(out))
}
if(!is.list(e1)) {
return(ikw.bilateral(e1))
}
if(!is.list(e2)) {
return(ikw.bilateral(e2))
}
}
