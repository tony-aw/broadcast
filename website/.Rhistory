R_xlen_t index0 = REAL(index)[0];
if(rcpp_OK_listclass(temp, recurse_classed) && (Rf_xlength(temp) > 0) && (depth < maxdepth)) {
rcpp_rec_depths(temp, out, index, depth + 1, maxdepth, recurse_classed);
}
else {
pout[index0] = depth;
REAL(index)[0] = index0 + 1;
}
}
}
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_rec_len)]]
void rcpp_rec_len(
SEXP x, SEXP out, SEXP index, int depth, int depth_target, bool recurse_classed
) {
int n = Rf_xlength(x);
for(int i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(depth == depth_target) {
SET_REAL_ELT(out, REAL(index)[0], Rf_xlength(temp));
SET_REAL_ELT(index, 0, REAL(index)[0] + 1);
}
else if(rcpp_OK_listclass(temp, recurse_classed) && depth != depth_target && Rf_xlength(temp) != 0) {
rcpp_rec_len(temp, out, index, depth + 1, depth_target, recurse_classed);
}
}
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_hiercast_surface_OK)]]
bool rcpp_hiercast_surface_OK(
SEXP x, bool recurse_classed
) {
double n = Rf_xlength(x);
for(R_xlen_t i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(!rcpp_OK_listclass(temp, recurse_classed) || (Rf_xlength(temp) == 0)) {
return false;
}
}
return true;
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_rec_hiercast)]]
void rcpp_rec_hiercast(
SEXP x, SEXP out, SEXP dcp, int dimpart_prev, int depth, int depth_target
) {
const double dcp_current = REAL_RO(dcp)[depth - 1];
R_xlen_t dimpart_current;
R_xlen_t flatind;
if(depth == depth_target) {
for(R_xlen_t i = 0; i < Rf_xlength(x); ++i) {
dimpart_current = i * dcp_current + dimpart_prev;
SEXP temp = VECTOR_ELT(x, i);
SET_VECTOR_ELT(out, dimpart_current, temp);
}
}
else {
for(R_xlen_t i = 0; i < Rf_xlength(x); ++i) {
dimpart_current = i * dcp_current + dimpart_prev;
SEXP temp = VECTOR_ELT(x, i);
rcpp_rec_hiercast(temp, out, dcp, dimpart_current, depth + 1, depth_target);
}
}
}
"
Rcpp::sourceCpp(code = code)
x <- list(
list(as.list(1:10)),
list(as.list(1:9)),
list(1:11),
list(list()),
list(list(NULL)),
data.frame(letters, LETTERS)
)
ld <- function(y,i) if(is.list(y) && !is.data.frame(y)) lapply(y,ld,i+1L) else i
depths <- unlist(ld(x, 0))
hier_depths <- function(x, recurse_classed = FALSE) {
n <- hier_flatlen(x, recurse_classed) |> C_hier_clone()
out <- rep(NA_real_, n) |> C_hier_clone()
index <- C_hier_clone(0.0)
depth <- C_hier_clone(1.0)
maxdepth <- C_hier_clone(2^31 - 1L)
.rcpp_rec_depths(x, out, index, depth, maxdepth, recurse_classed)
return(out)
}
out <- hier_depths(x)
out2 <- hier_depths(x)
collapse::ldepth(x)
out
collapse::ldepth(x)
tinytest::expect_equal(
out, out2
)
hier_depths(x)
hier_len_rec <- function(x, depth, n, recurse_classed = FALSE) {
index <- C_hier_clone(0.0)
out <- vector("double", n)
.rcpp_rec_len(x, out, index, 1.0, depth, recurse_classed)
return(out)
}
