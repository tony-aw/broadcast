Sys.setenv(PKG_CXXFLAGS = "-O3 -march=native -fopenmp-simd -fno-math-errno -fno-trapping-math -ffp-contract=fast")
header <- "
#include <Rcpp/Lightest>
using namespace Rcpp;
#if defined(_OPENMP) || defined(_OPENMP_SIMD)
#define FORCE_SIMD _Pragma(\"omp simd\")
#elif defined(__GNUC__) || defined(__clang__)
#define FORCE_SIMD _Pragma(\"GCC ivdep\")
#elif defined(_MSC_VER)
#define FORCE_SIMD __pragma(loop(ivdep))
#else
#define FORCE_SIMD
#endif
"
odometer_helper <- "
// De odometer helper-functie.
// Deze beheert dimensie 1 t/m (NDIM-1). Dimensie 0 zit in de snelle binnenloop!
static inline void odometer_step(
int ndim, int *iters, const int *N_bounds,
R_xlen_t *current_x, R_xlen_t *current_y,
const R_xlen_t *stride_x, const R_xlen_t *stride_y
) {
// basic relationship between flat index at one hand,
// and the dimensional iterations and strides at the other hand:
// flatind = iter1 * stride1 + iter2 * stride2 + etc.
// at start, all iters are 0, thus flatind is 0:
// flatind = 0 + 0 + etc. == 0.
// as we go through the rows, flatind increases with iter1 * stride1:
// flatind = iter1 * stride1
// when all rows (d=0) have been passed,
// we need to add the contribution of going to the next column:
// (iter2 = 1) * stride2; this is simply +stride2
// AND we need to RESET the row's contribution,
// meaning we need to REMOVE what the rows have accumulated:
// remove `iter1 * stride1 * (N1 - 1)`
// then we once again accumulate rows.
// everytime we've gone through all rows:
// - REMOVE the contribution to the rows; i.e. remove `iter1 * stride1 * (N1 - 1)`
// - we arleady have iter2=1; now we need iter2 = 2, so add +stride2 to the flatind.
// and so we go on.
// at some point, we've gone through all the columns and rows.
// then we do to the columns what we do with the rows:
// - remove the contribution of the columns
// - remove the contribution of the rows also
// - we need to add the contribution of going to the next layer:
//      (iter3 = 1) * stride3; this is simply +stride3
// and so we continue
// notice that after each cycle, flatind is pushed back by the stride of the current dimension.
// but flatind never gets pushed back further than the stride of one dimension.
// this, in a lighting-shape, we eventually keep moving forward, not backward.
// Like a cartesian product
// We start at d = 1, since d=0 represents the rows (C/C++ counts from 0 obviously)
for (int d = 1; d < ndim; ++d) {
iters[d]++; // this always start with increasing the column iterator;
// whether we can even reach further dimensions depends on the if-else statements below...
if (iters[d] < N_bounds[d]) {
// do the following if we have NOT gone through all iters of dimension `d`
*current_x += stride_x[d]; // add contribution from column, layer, etc.
*current_y += stride_y[d]; // add contribution from column, layer, etc.
break; // done; do NOT run for the next `d`s
} else {
// dimension `d` (column, layer, etc.) is done; time to....
iters[d] = 0; // reset iterator of current dimension (column, layer, etc.)
*current_x -= stride_x[d] * (N_bounds[d] - 1); // remove its contribution
*current_y -= stride_y[d] * (N_bounds[d] - 1); // remove its contribution
// NO BREAK! we'll continue to d+1...
}
}
}
"
inline1 <- "
std::vector<R_xlen_t> inline_alloc_strides(
IntegerVector target_dim
) {
// get properties:
int n = Rf_length(target_dim);
if(n > 16) {
stop(\"dimensionality > 16 \");
}
std::vector<R_xlen_t> out(16);
const int *ptarget = INTEGER_RO(target_dim);
// make dcp:
R_xlen_t temp_prod = ptarget[0];
out[0] = 1;
if(n > 1) {
out[1] = ptarget[0];
}
if(n > 2) {
for(int i = 2; i < n; ++i) {
temp_prod = temp_prod * ptarget[i-1];
out[i] = temp_prod;
}
}
// mulitply with by (i.e. make it zero when appropriate):
for(int i = 0; i < n; ++i) {
if(ptarget[i] <= 1) {
out[i] = 0;
}
}
return out;
}
"
Rcpp::cppFunction(inline1)
inline2 <- "
std::vector<int> inline_alloc_bounds(
IntegerVector out_dim, int ndim
) {
const int *pout_dim = INTEGER_RO(out_dim);
if(ndim > 16 || Rf_length(out_dim) > 16) {
stop(\"dimensionality > 16 \");
}
std::vector<int> N_bounds(16);
for (int d = 0; d < 16; ++d) {
N_bounds[d] = 1;
}
for (int d = 0; d < ndim; ++d) {
N_bounds[d] = pout_dim[d];
}
return N_bounds;
}
"
Rcpp::cppFunction(inline2)
inline3 <- "
int inline_determine_loopdepth(
IntegerVector out_dim
) {
if(Rf_length(out_dim) > 16) {
stop(\"dimensionality > 16 \");
}
int n = Rf_length(out_dim);
const int *pod = INTEGER_RO(out_dim);
int rm = 0;
for(int i = (n-1); i >= 0; --i) {
if(pod[i] == 1) {
rm++;
}
else {
break;
}
}
int loopdepth = n - rm;
if(loopdepth == 0) {
loopdepth = 1;
}
if(loopdepth > 16) {
loopdepth = 16;
}
return loopdepth;
}
"
inline4 <- "
R_xlen_t inline_determine_outer_Niters(std::vector<int> alloc_N_bounds) {
// We multiply all alloc_N_bounds EXCEPT(!!!) the rows
R_xlen_t outer_Niters = 1;
int n = alloc_N_bounds.size();
if(n == 1) return outer_Niters;
for(int i = 1; i < n; ++i) {
outer_Niters *= alloc_N_bounds[i];
}
return outer_Niters;
}
"
inlines <- paste0(odometer_helper, inline1, inline2, inline3, inline4, collapse = "\n")
macro_old <- "
#define MACRO_DIM_OLD(DOCODE, GETX, GETY) do { \\
\\
/* Get const properties */  \\
const int ndim = inline_determine_loopdepth(out_dim); \\
const int *pout_dim = INTEGER_RO(out_dim);  \\
const std::vector<R_xlen_t> alloc_stride_x = inline_alloc_strides(x_dim);  \\
const std::vector<R_xlen_t> alloc_stride_y = inline_alloc_strides(y_dim);  \\
const std::vector<int> alloc_N_bounds = inline_alloc_bounds(out_dim, ndim); \\
const R_xlen_t outer_Niters = inline_determine_outer_Niters(alloc_N_bounds);  \\
\\
/* Declare variables */  \\
R_xlen_t flatind_out = 0; \\
R_xlen_t current_x = 0; \\
R_xlen_t current_y = 0; \\
int iters[16] = {0}; \\
int N_bounds[16] = {0}; \\
R_xlen_t stride_x[16] = {0}; \\
R_xlen_t stride_y[16] = {0}; \\
\\
/*Initialise C-arrays */  \\
const int N1 = pout_dim[0]; /* De bound voor de binnenste loop */ \\
for (int d = 0; d < ndim; ++d) { \\
N_bounds[d] = pout_dim[d]; \\
stride_x[d] = alloc_stride_x[d]; \\
stride_y[d] = alloc_stride_y[d]; \\
N_bounds[d] = alloc_N_bounds[d]; \\
} \\
\\
/* Outer-looop */ \\
for (R_xlen_t outer = 0; outer < outer_Niters; ++outer) { \\
\\
/* Loop through rows */ \\
for (int iter1 = 0; iter1 < N1; ++iter1) { \\
R_xlen_t flatind_x = stride_x[0] * iter1 + current_x; \\
R_xlen_t flatind_y = stride_y[0] * iter1 + current_y; \\
\\
GETX; \\
GETY; \\
DOCODE; \\
\\
flatind_out++; \\
} \\
\\
odometer_step(ndim, iters, N_bounds, &current_x, &current_y, stride_x, stride_y); \\
} \\
} while(0)
"
macro_new <- "
#define MACRO_DIM_NEW(DOCODE, GETX, GETY) do { \\
\\
/* Get const properties */  \\
const int ndim = inline_determine_loopdepth(out_dim); \\
const int *pout_dim = INTEGER_RO(out_dim);  \\
const std::vector<R_xlen_t> alloc_stride_x = inline_alloc_strides(x_dim);  \\
const std::vector<R_xlen_t> alloc_stride_y = inline_alloc_strides(y_dim);  \\
const std::vector<int> alloc_N_bounds = inline_alloc_bounds(out_dim, ndim); \\
const R_xlen_t outer_Niters = inline_determine_outer_Niters(alloc_N_bounds);  \\
\\
/* Declare variables */  \\
R_xlen_t flatind_out = 0; \\
R_xlen_t current_x = 0; \\
R_xlen_t current_y = 0; \\
int iters[16] = {0}; \\
int N_bounds[16] = {0}; \\
R_xlen_t stride_x[16] = {0}; \\
R_xlen_t stride_y[16] = {0}; \\
\\
/*Initialise C-arrays */  \\
const int N1 = pout_dim[0]; /* De bound voor de binnenste loop */ \\
for (int d = 0; d < ndim; ++d) { \\
N_bounds[d] = pout_dim[d]; \\
stride_x[d] = alloc_stride_x[d]; \\
stride_y[d] = alloc_stride_y[d]; \\
N_bounds[d] = alloc_N_bounds[d]; \\
} \\
\\
/* Outer-looop */ \\
for (R_xlen_t outer = 0; outer < outer_Niters; ++outer) { \\
\\
/* Loop through rows */ \\
FORCE_SIMD  \\
for (int iter1 = 0; iter1 < N1; ++iter1) { \\
R_xlen_t flatind_x = stride_x[0] * iter1 + current_x; \\
R_xlen_t flatind_y = stride_y[0] * iter1 + current_y; \\
\\
GETX; \\
GETY; \\
DOCODE; \\
\\
flatind_out++; \\
} \\
\\
odometer_step(ndim, iters, N_bounds, &current_x, &current_y, stride_x, stride_y); \\
} \\
} while(0)
"
fun_old <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_old, rng = false)]]
SEXP rcpp_bc_dec_old(
SEXP x, SEXP y,
SEXP x_dim, SEXP y_dim,
SEXP out_dim, R_xlen_t nout
) {
SEXP out =  PROTECT(Rf_allocVector(REALSXP, nout));;
double *pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_OLD(
pout[flatind_out] = tempx + tempy,
const double tempx = px[flatind_x],
const double tempy = py[flatind_y]
);
UNPROTECT(1);
return out;
}
"
fun_new <- "
// [[Rcpp::plugins(openmp)]]
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_new, rng = false)]]
SEXP rcpp_bc_dec_new(
SEXP x, SEXP y,
SEXP x_dim, SEXP y_dim,
SEXP out_dim, R_xlen_t nout
) {
SEXP out =  PROTECT(Rf_allocVector(REALSXP, nout));;
double *pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_NEW(
pout[flatind_out] = tempx + tempy,
const double tempx = px[flatind_x],
const double tempy = py[flatind_y]
);
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = paste0(header, inlines, macro_old, fun_old, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, inlines, macro_new, fun_new, collapse = "\n"))
# RUN BENCH (fewer rows) ====
ndim <- broadcast::ndim
n <- 300
x <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(n*2, 1, n/2))
y <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(1, n, 1))
x.dim <- c(dim(x), rep(1L, 16L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 16L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
# RUN BENCH (more rows) ====
ndim <- broadcast::ndim
n <- 300
x <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(n/2, 1, n*2))
y <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(1, n, 1))
x.dim <- c(dim(x), rep(1L, 16L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 16L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <-  broadcast:::.C_make_dcp(y.dim)
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 16L - length(out.dim)))
out.len <- prod(out.dim)
invisible(gc())
invisible(gc())
foo <- bench::mark(
old = .rcpp_bc_dec_old(x, y, x.dim, y.dim, out.dim, out.len),
new = .rcpp_bc_dec_new(x, y, x.dim, y.dim, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
