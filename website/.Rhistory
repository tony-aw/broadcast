clippable <- function(txt) {
# ... your logic ...
code_call <- txt
# Print the static text
cat("\n# Static code:\n", code_call, "\n")
# Create a clickable console hyperlink that executes an R command when clicked
# We escape the text so it can safely sit inside an expression
safe_text <- gsub("'", "\\'", code_call, fixed = TRUE)
# Use RStudio's capability to execute R code via a click
click_command <- sprintf("utils::writeClipboard('%s'); message('✓ Copied!')", safe_text)
# Format it as an ANSI hyperlink button
cat(sprintf("\033]8;;xterm:expr=%s\033\135[ Click to Copy ]\033]8;;\033\\ \n\n", click_command))
return(invisible(c("%>%", "%:%")))
}
clippable(c("stri_sub", "stri_sub<-", "%s+%"))
clippable(c("stri_sub", "stri_sub<-", "%s+%"))
clippable <- function(txt) {
# 1. format the library call code exactly as it should look
code_call <- txt
# Print the static text representation
cat("\n# Static code:\n", code_call, "\n\n")
# Escape single quotes so it doesn't break the string parser
safe_text <- gsub("'", "\\'", code_call, fixed = TRUE)
# 2. Build the click action command
# Note: utils::writeClipboard works natively on Windows.
# For cross-platform support without clipr, you can use clipr::write_clip()
click_command <- sprintf("utils::writeClipboard('%s'); message('✓ Copied to Clipboard!')", safe_text)
# 3. Create the clickable link using cli's .run protocol
cli::cli_text("{.run [{symbol$pointer} Click here to copy code]( {click_command} )}")
cat("\n")
return(invisible(txt))
}
