},
internal_prep = for(i in 1:100) {
broadcast:::.binary_prep(a, b, sys.call())
},
stop_conf = for(i in 1:100) {
broadcast:::.C_check_conf_dim(a.dim, b.dim, a.len, b.len)
},
mergedims = for(i in 1:100) {
mergedims(a.dim, b.dim)
},
normalize = for(i in 1:100) {
normalize_dims(a.dim, b.dim)
},
dropcommons = for(i in 1:100) {
drop_commons(a.dim, b.dim)
},
nullify = for(i in 1:100) {
nullify_dims(a, b)
},
dimmode = for(i in 1:100) {
broadcast:::.C_determine_dimmode(a.dim, b.dim, a.len, b.len)
},
check = FALSE,
min_iterations = 100,
)
summary(foo)
ggplot2::autoplot(foo)
