ndim <- broadcast::ndim
n <- function()sample(seq(75, 85, by = 5), 1L)
x <- array(rnorm(100), c(n(), 1, n(), 1))
y <- array(rnorm(100), c(1, 1, 1, n()))
x.dim <- c(dim(x), rep(1L, 16L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 16L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <-  broadcast:::.C_make_dcp(y.dim)
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 16L - length(out.dim)))
out.len <- prod(out.dim)
invisible(gc())
foo <- bench::mark(
old = rcpp_bc_old(x.dim, y.dim, out.dim, out.len),
new = rcpp_bc_new(x.dim, y.dim, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
fun_old <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_bc_old, rng = false)]]
SEXP rcpp_bc_old(
SEXP x_dim, SEXP y_dim, SEXP out_dim, R_xlen_t nout
) {
IntegerVector out1(nout);
IntegerVector out2(nout);
int *pout1 = INTEGER(out1);
int *pout2 = INTEGER(out2);
MACRO_DIM_OLD(
pout1[flatind_out] = tempx; pout2[flatind_out] = tempy,
const int tempx = flatind_x,
const int tempy = flatind_y
);
List out(2);
out[0] = out1;
out[1] = out2;
return out;
}
"
fun_new <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_bc_new, rng = false)]]
SEXP rcpp_bc_new(
SEXP x_dim, SEXP y_dim, SEXP out_dim, R_xlen_t nout
) {
IntegerVector out1(nout);
IntegerVector out2(nout);
int *pout1 = INTEGER(out1);
int *pout2 = INTEGER(out2);
MACRO_DIM_NEW(
pout1[flatind_out] = tempx; pout2[flatind_out] = tempy,
const int tempx = flatind_x,
const int tempy = flatind_y
);
List out(2);
out[0] = out1;
out[1] = out2;
return out;
}
"
Rcpp::sourceCpp(code = paste0(header, inlines, odometer_helper_old, macro_old, fun_old, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, inlines, odometer_helper_new, macro_new, fun_new, collapse = "\n"))
