code <- "
#include <Rcpp.h>
using namespace Rcpp;
//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_testdbl)]]
SEXP rcpp_testdbl(
SEXP x, SEXP y
) {
const int *px = INTEGER_RO(x);
const int *py = INTEGER_RO(y);
R_xlen_t n = Rf_xlength(x);
SEXP out = PROTECT(Rf_allocVector(REALSXP, n));
double *pout;
pout = REAL(out);
for(R_xlen_t i = 0; i < n; ++i) {
pout[i] = (double)px[i] + (double)py[i];
}
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = code)
code <- "
#include <Rcpp.h>
using namespace Rcpp;
//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_testint)]]
SEXP rcpp_testint(
SEXP x, SEXP y
) {
const int *px = INTEGER_RO(x);
const int *py = INTEGER_RO(y);
R_xlen_t n = Rf_xlength(x);
SEXP out = PROTECT(Rf_allocVector(REALSXP, n));
double *pout;
pout = REAL(out);
for(R_xlen_t i = 0; i < n; ++i) {
pout[i] = px[i] + py[i];
}
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = code)
n <- 1e7
x <- sample(1:n)
y <- sample(1:n)
gc()
foo <- bench::mark(
testint = rcpp_testint(x, y),
testdbl = rcpp_testdbl(x, y),
check = FALSE,
min_iterations = 100,
)
summary(foo)
ggplot2::autoplot(foo)
