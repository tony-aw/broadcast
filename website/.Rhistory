case LGLSXP:                                                              \\
{                                                                         \\
DOCODE(py[i] == NA_INTEGER, py[i] != NA_INTEGER);                       \\
}                                                                         \\
case REALSXP:                                                             \\
{                                                                         \\
DOCODE(R_isnancpp(py[i]), !R_isnancpp(py[i]));                          \\
}                                                                         \\
case CPLXSXP:                                                             \\
{                                                                         \\
DOCODE(                                                                 \\
R_isnancpp(py[i].r) || R_isnancpp(py[i].i),                           \\
!R_isnancpp(py[i].i) && !R_isnancpp(py[i].r))                         \\
);                                                                      \\
}                                                                         \\
case STRSXP:                                                              \\
{                                                                         \\
DOCODE(py[i] == NA_STRING, py[i] != NA_STRING);                         \\
}                                                                         \\
case VECSXP:                                                              \\
{                                                                         \\
DOCODE(VECTOR_ELT(y, i) == R_NilValue, VECTOR_ELT(y, i) != R_NilValue); \\
}                                                                         \\
case RAWSXP:                                                              \\
{                                                                         \\
stop(\"NAs not defined for type `raw`\");                               \\
}                                                                         \\
default: stop(\"Unsupported type\");                                      \\
}                                                                           \\
} while(0)
"
library(stringi)
header <- "
#include <Rcpp/Lightest>
using namespace Rcpp;
"
macro_checkmissing_typeswitch <- "
#define MACRO_CHECKMISSING_TYPESWITCH(MACROCODE, DOCODE) do { \\
switch(TYPEOF(y)) {                                                         \\
case INTSXP:                                                              \\
case LGLSXP:                                                              \\
{                                                                         \\
const int *py = INTEGER_RO(y);                                          \\
MACROCODE(DOCODE, py[i] == NA_INTEGER, py[i] != NA_INTEGER);                       \\
}                                                                         \\
case REALSXP:                                                             \\
{                                                                         \\
const double *py = REAL_RO(y);                                          \\
MACROCODE(DOCODE, R_isnancpp(py[i]), !R_isnancpp(py[i]));                          \\
}                                                                         \\
case CPLXSXP:                                                             \\
{                                                                         \\
const Rcomplex *py = COMPLEX_RO(y);                                     \\
MACROCODE(                                                              \\
DOCODE,                                                               \\
R_isnancpp(py[i].r) || R_isnancpp(py[i].i),                           \\
!R_isnancpp(py[i].i) && !R_isnancpp(py[i].r))                         \\
);                                                                      \\
}                                                                         \\
case STRSXP:                                                              \\
{                                                                         \\
const SEXP *py = STRING_PTR_RO(y);                                      \\
MACROCODE(DOCODE, py[i] == NA_STRING, py[i] != NA_STRING);              \\
}                                                                         \\
case VECSXP:                                                              \\
{                                                                         \\
MACROCODE(                                                              \\
DOCODE,                                                               \\
VECTOR_ELT(y, i) == R_NilValue,                                       \\
VECTOR_ELT(y, i) != R_NilValue                                        \\
);                                                                      \\
}                                                                         \\
case RAWSXP:                                                              \\
{                                                                         \\
stop(\"NAs not defined for type `raw`\");                               \\
}                                                                         \\
default: stop(\"Unsupported type\");                                      \\
}                                                                           \\
} while(0)
"
macro_checkmissing_is <- "
#define MACRO_CHECKMISSING_IS(DOCODE, ISNACODE, ISNOTNACODE) do {  \\
if(condition) {                                                         \\
for(R_xlen_t i = 0; i < n; ++i) {                                     \\
DOCODE = ISNACODE;                                                    \\
}                                                                     \\
}                                                                       \\
else if(!condition) {                                                   \\
for(R_xlen_t i = 0; i < n; ++i) {                                     \\
DOCODE = ISNOTNACODE;                                              \\
}                                                                     \\
}                                                                       \\
else {                                                                  \\
stop(\"`invert` must be `TRUE` or `FALSE`\");                         \\
}                                                                       \\
break;                                                                  \\
} while(0)
"
macro_checkmissing_fw <- "
#define MACRO_CHECKMISSING_FW(DOCODE, ISNACODE, ISNOTNACODE) do {             \\
if(condition) {                                                         \\
for(R_xlen_t i = 0; i < n; ++i) {                                     \\
if(ISNACODE) {                                           \\
DOCODE;                                                           \\
}                                                                   \\
}                                                                     \\
}                                                                       \\
else if(!condition) {                                                   \\
for(R_xlen_t i = 0; i < n; ++i) {                                     \\
if(ISNOTNACODE) {                                           \\
DOCODE;                                                           \\
}                                                                   \\
}                                                                     \\
}                                                                       \\
else {                                                                  \\
stop(\"`invert` must be `TRUE` or `FALSE`\");                         \\
}                                                                       \\
} while(0)
"
macro_checkmissing_bw <- stringi::stri_replace_all(
macro_checkmissing_fw,
"R_xlen_t i = (n-1); i >= 0; --i",
fixed = "R_xlen_t i = 0; i < n; ++i"
)
macro_checkmissing_bw <- stringi::stri_replace_first(
macro_checkmissing_bw,
"MACRO_ACTION_CHECKMISSING_BW",
fixed = "MACRO_ACTION_CHECKMISSING_FW"
)
cat(macro_action_checkmissing_bw)
cat(macro_checkmissing_bw)
library(broadcast)
x <- list(
group1 = list(
class1 = list(
height = rnorm(5, 170) |> as.integer(),
weight = rnorm(5, 80)  |> as.integer(),
sex = sample(c("M", "F", NA), 5, TRUE)
),
class2 = list(
height = rnorm(5, 170)  |> as.integer(),
weight = rnorm(5, 80) |> as.integer(),
sex = sample(c("M", "F", NA), 5, TRUE)
)
),
group2 = list(
class1 = list(
height = rnorm(5, 170) |> as.integer(),
weight = rnorm(5, 80) |> as.integer(),
sex = sample(c("M", "F", NA), 5, TRUE)
),
class2 = list(
height = rnorm(5, 170) |> as.integer(),
weight = rnorm(5, 80) |> as.integer(),
sex = sample(c("M", "F", NA), 5, TRUE)
)
)
)
x2 <- cast_hier2dim(x)
dimnames(x2) <- hiernames2dimnames(x)
x3 <- cast_dim2hier(x2, in2out = FALSE)
lobstr::tree(x3)
x3 <- cast_dim2hier(x2, in2out = FALSE, distr.names = TRUE)
lobstr::tree(x3)
