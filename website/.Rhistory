code <- "
#include <Rcpp.h>
using namespace Rcpp;
inline bool rcpp_OK_listclass(
SEXP x, bool recurse_classed
) {
if(TYPEOF(x) != VECSXP) {
return false;
}
if(recurse_classed) {
return true;
}
return (Rf_getAttrib(x, R_ClassSymbol) == R_NilValue);
}
inline void rcpp_rec_dropnests(
SEXP x, SEXP out, SEXP index, bool recurse_classed
) {
double n = Rf_xlength(x);
for(R_xlen_t i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(rcpp_OK_listclass(temp, recurse_classed) && Rf_xlength(temp) == 1) {
rcpp_rec_dropnests(temp, out, index, recurse_classed);
}
else {
SET_VECTOR_ELT(out, REAL(index)[0], temp);
REAL(index)[0] = REAL(index)[0] + 1;
}
}
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_dropnests)]]
SEXP rcpp_dropnests(
SEXP x, bool recurse_classed
) {
SEXP index = PROTECT(Rf_allocVector(REALSXP, 1));
REAL(index)[0] = 0;
SEXP out = PROTECT(Rf_allocVector(VECSXP, Rf_xlength(x)));
rcpp_rec_dropnests(x, out, index, recurse_classed);
UNPROTECT(2);
return out;
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_subset_list)]]
List rcpp_subset_list(
List x, SEXP ind
) {
R_xlen_t n = Rf_xlength(ind);
List out(n);
const double *pind = REAL_RO(ind);
// subset list
for(R_xlen_t i = 0; i < n; ++i) {
out[i] = x[pind[i]];
}
return out;
}
"
Rcpp::sourceCpp(code = code)
x <- list(
list(list(list(list(1L)))),
as.list(1:10),
list(list(list())),
list(list(NULL)),
data.frame(letters)
)
.rcpp_subset_list(x, 1:2)
.rcpp_subset_list(x, as.double(1:2))
.rcpp_subset_list(x, as.double(0:2))
x <- as.list(1:10)
names)x
names(x) <- letters[1:10]
x
.rcpp_subset_list(x, as.double(0:2))
code <- "
#include <Rcpp.h>
using namespace Rcpp;
inline bool rcpp_OK_listclass(
SEXP x, bool recurse_classed
) {
if(TYPEOF(x) != VECSXP) {
return false;
}
if(recurse_classed) {
return true;
}
return (Rf_getAttrib(x, R_ClassSymbol) == R_NilValue);
}
inline void rcpp_rec_dropnests(
SEXP x, SEXP out, SEXP index, bool recurse_classed
) {
double n = Rf_xlength(x);
for(R_xlen_t i = 0; i < n; ++i) {
SEXP temp = VECTOR_ELT(x, i);
if(rcpp_OK_listclass(temp, recurse_classed) && Rf_xlength(temp) == 1) {
rcpp_rec_dropnests(temp, out, index, recurse_classed);
}
else {
SET_VECTOR_ELT(out, REAL(index)[0], temp);
REAL(index)[0] = REAL(index)[0] + 1;
}
}
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_dropnests)]]
SEXP rcpp_dropnests(
SEXP x, bool recurse_classed
) {
SEXP index = PROTECT(Rf_allocVector(REALSXP, 1));
REAL(index)[0] = 0;
SEXP out = PROTECT(Rf_allocVector(VECSXP, Rf_xlength(x)));
rcpp_rec_dropnests(x, out, index, recurse_classed);
UNPROTECT(2);
return out;
}
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_subset_list)]]
List rcpp_subset_list(
List x, NumericVector ind
) {
return x[ind];
}
"
Rcpp::sourceCpp(code = code)
.rcpp_subset_list(x, as.double(0:2))
.rcpp_subset_list(x, c(0, 2))
