# making objects that one might get from a usual large regression model:
n <- 5e3
X <- matrix(rnorm(n), 1, n)
X1 <- X[1, , drop = FALSE]
w <- t(X1)
vc <- cov(as.data.frame(X))
gc()
bm_la <- bench::mark(
t(w) %*% vc %*% w,
sd_lc(X1, vc),
check = FALSE,
min_iterations = 100
)
summary(bm_la)
plot(bm_la)
