"
Rcpp::sourceCpp(code = paste0(header, inlines, odomacro, macro_seq, fun_old, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, inlines, odomacro, macro_seq, macro_par, fun_new, collapse = "\n"))
# RUN BENCH (more rows) ====
ndim <- broadcast::ndim
n <- 391
x <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(n, 1, n))
y <- array(sample(c(1:25, Inf, -Inf, NaN, NA)), c(1, n, 1))
x.dim <- c(dim(x), rep(1L, 16L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 16L - ndim(y)))
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 16L - length(out.dim)))
out.len <- prod(out.dim)
out.len/8
Sys.setenv(PKG_CXXFLAGS = "-O3 -march=native -fopenmp-simd -fno-math-errno -fno-trapping-math -ffp-contract=fast")
header <- "
#include <Rcpp/Lightest>
using namespace Rcpp;
#ifdef _OPENMP
#include <omp.h>
#endif
"
inline1 <- "
std::vector<R_xlen_t> inline_alloc_strides(
IntegerVector target_dim
) {
// get properties:
int n = Rf_length(target_dim);
if(n > 16) {
stop(\"dimensionality > 16 \");
}
std::vector<R_xlen_t> out(16);
const int *ptarget = INTEGER_RO(target_dim);
// make dcp:
R_xlen_t temp_prod = ptarget[0];
out[0] = 1;
if(n > 1) {
out[1] = ptarget[0];
}
if(n > 2) {
for(int i = 2; i < n; ++i) {
temp_prod = temp_prod * ptarget[i-1];
out[i] = temp_prod;
}
}
// mulitply with by (i.e. make it zero when appropriate):
for(int i = 0; i < n; ++i) {
if(ptarget[i] <= 1) {
out[i] = 0;
}
}
return out;
}
"
Rcpp::cppFunction(inline1)
inline2 <- "
std::vector<int> inline_alloc_bounds(
IntegerVector out_dim, int ndim
) {
const int *pout_dim = INTEGER_RO(out_dim);
if(ndim > 16 || Rf_length(out_dim) > 16) {
stop(\"dimensionality > 16 \");
}
std::vector<int> N_bounds(16);
for (int d = 0; d < 16; ++d) {
N_bounds[d] = 1;
}
for (int d = 0; d < ndim; ++d) {
N_bounds[d] = pout_dim[d];
}
return N_bounds;
}
"
Rcpp::cppFunction(inline2)
inline3 <- "
int inline_determine_loopdepth(
IntegerVector out_dim
) {
if(Rf_length(out_dim) > 16) {
stop(\"dimensionality > 16 \");
}
int n = Rf_length(out_dim);
const int *pod = INTEGER_RO(out_dim);
int rm = 0;
for(int i = (n-1); i >= 0; --i) {
if(pod[i] == 1) {
rm++;
}
else {
break;
}
}
int loopdepth = n - rm;
if(loopdepth == 0) {
loopdepth = 1;
}
if(loopdepth > 16) {
loopdepth = 16;
}
return loopdepth;
}
"
inline4 <- "
R_xlen_t inline_determine_outer_Niters(std::vector<int> alloc_N_bounds) {
// We multiply all alloc_N_bounds EXCEPT(!!!) the rows
R_xlen_t outer_Niters = 1;
int n = alloc_N_bounds.size();
if(n == 1) return outer_Niters;
for(int i = 1; i < n; ++i) {
outer_Niters *= alloc_N_bounds[i];
}
return outer_Niters;
}
"
inlines <- paste0(inline1, inline2, inline3, inline4, collapse = "\n")
odomacro <- "
#define odomacro(ndim, iters, N_bounds, current_x, current_y, stride_x, stride_y, contrib_x, contrib_y) do { \\
for (int d = 1; d < ndim; ++d) {  \\
iters[d]++;                     \\
if (iters[d] < N_bounds[d]) {   \\
current_x += stride_x[d];     \\
current_y += stride_y[d];     \\
break;                        \\
} else {                        \\
iters[d] = 0;                 \\
current_x -= contrib_x[d];    \\
current_y -= contrib_y[d];    \\
}                               \\
}                                 \\
} while(0)
"
macro_seq <- "
#define MACRO_DIM_ODOMETER_SEQ(DOCODE, GETX, GETY) do { \\
\\
/* Get const properties */  \\
const int ndim = inline_determine_loopdepth(out_dim); \\
const int *pout_dim = INTEGER_RO(out_dim);  \\
const std::vector<R_xlen_t> alloc_stride_x = inline_alloc_strides(x_dim);  \\
const std::vector<R_xlen_t> alloc_stride_y = inline_alloc_strides(y_dim);  \\
const std::vector<int> alloc_N_bounds = inline_alloc_bounds(out_dim, ndim); \\
const R_xlen_t outer_Niters = inline_determine_outer_Niters(alloc_N_bounds);  \\
\\
/* Declare variables */  \\
R_xlen_t flatind_out = 0; \\
R_xlen_t current_x = 0; \\
R_xlen_t current_y = 0; \\
int iters[16] = {0}; \\
int N_bounds[16] = {0}; \\
R_xlen_t stride_x[16] = {0}; \\
R_xlen_t stride_y[16] = {0}; \\
R_xlen_t contrib_x[16]= {0};  \\
R_xlen_t contrib_y[16] = {0}; \\
\\
/*Initialise C-arrays */  \\
const int N1 = pout_dim[0]; /* De bound voor de binnenste loop */ \\
for (int d = 0; d < ndim; ++d) { \\
N_bounds[d] = pout_dim[d]; \\
stride_x[d] = alloc_stride_x[d]; \\
stride_y[d] = alloc_stride_y[d]; \\
N_bounds[d] = alloc_N_bounds[d]; \\
contrib_x[d] = stride_x[d] * (N_bounds[d] - 1); \\
contrib_y[d] = stride_y[d] * (N_bounds[d] - 1); \\
} \\
\\
/* Outer-looop */ \\
for (R_xlen_t outer = 0; outer < outer_Niters; ++outer) { \\
R_xlen_t flatind_x = current_x; \\
R_xlen_t flatind_y = current_y; \\
const R_xlen_t stride_x1 = stride_x[0]; \\
const R_xlen_t stride_y1 = stride_y[0]; \\
/* Loop through rows */ \\
for (int iter1 = 0; iter1 < N1; ++iter1) { \\
GETX; \\
GETY; \\
DOCODE; \\
\\
flatind_out++; \\
flatind_x += stride_x1; \\
flatind_y += stride_y1; \\
} \\
\\
odomacro(  \\
ndim, iters, N_bounds, current_x, current_y, stride_x, stride_y, contrib_x, contrib_y \\
); \\
} \\
} while(0)
"
macro_par <- "
// [[Rcpp::plugins(openmp)]]
#ifdef _OPENMP
#include <omp.h>
#endif
// 2. Parallel Odometer Macro (falls back cleanly to SEQ if OpenMP is unavailable)
#ifdef _OPENMP
#define MACRO_DIM_ODOMETER_PAR(N_THREADS, DOCODE, GETX, GETY) do { \\
const int ndim = inline_determine_loopdepth(out_dim); \\
const int *pout_dim = INTEGER_RO(out_dim); \\
const std::vector<R_xlen_t> alloc_stride_x = inline_alloc_strides(x_dim); \\
const std::vector<R_xlen_t> alloc_stride_y = inline_alloc_strides(y_dim); \\
const std::vector<int> alloc_N_bounds = inline_alloc_bounds(out_dim, ndim); \\
const R_xlen_t outer_Niters = inline_determine_outer_Niters(alloc_N_bounds); \\
\\
int N_bounds[16] = {0}; \\
R_xlen_t stride_x[16] = {0}; \\
R_xlen_t stride_y[16] = {0}; \\
R_xlen_t contrib_x[16] = {0}; \\
R_xlen_t contrib_y[16] = {0}; \\
\\
const int N1 = pout_dim[0]; \\
for (int d = 0; d < ndim; ++d) { \\
stride_x[d] = alloc_stride_x[d]; \\
stride_y[d] = alloc_stride_y[d]; \\
N_bounds[d] = alloc_N_bounds[d]; \\
contrib_x[d] = stride_x[d] * (N_bounds[d] - 1); \\
contrib_y[d] = stride_y[d] * (N_bounds[d] - 1); \\
} \\
\\
const R_xlen_t stride_x1 = stride_x[0]; \\
const R_xlen_t stride_y1 = stride_y[0]; \\
\\
_Pragma(\"omp parallel num_threads(N_THREADS)\") \\
{ \\
const int tid = omp_get_thread_num(); \\
const int nthreads = omp_get_num_threads(); \\
const R_xlen_t chunk = (outer_Niters + nthreads - 1) / nthreads; \\
const R_xlen_t start_outer = tid * chunk; \\
const R_xlen_t end_outer = std::min(outer_Niters, start_outer + chunk); \\
\\
if (start_outer < end_outer) { \\
int t_iters[16] = {0}; \\
R_xlen_t t_current_x = 0; \\
R_xlen_t t_current_y = 0; \\
\\
R_xlen_t rem = start_outer; \\
for (int d = 1; d < ndim; ++d) { \\
t_iters[d] = rem % N_bounds[d]; \\
rem /= N_bounds[d]; \\
t_current_x += t_iters[d] * stride_x[d]; \\
t_current_y += t_iters[d] * stride_y[d]; \\
} \\
\\
double* pout_cursor = pout + (start_outer * N1); \\
\\
for (R_xlen_t outer = start_outer; outer < end_outer; ++outer) { \\
const R_xlen_t base_x = t_current_x; \\
const R_xlen_t base_y = t_current_y; \\
\\
for (int iter1 = 0; iter1 < N1; ++iter1) { \\
const R_xlen_t flatind_x = base_x + iter1 * stride_x1; \\
const R_xlen_t flatind_y = base_y + iter1 * stride_y1; \\
const int flatind_out = iter1; \\
double* pout = pout_cursor; \\
GETX; \\
GETY; \\
DOCODE; \\
} \\
\\
pout_cursor += N1; \\
odomacro( \\
ndim, t_iters, N_bounds, t_current_x, t_current_y, stride_x, stride_y, contrib_x, contrib_y \\
); \\
} \\
} \\
} \\
} while(0)
#else
/* Automatic fallback when compiled without OpenMP (e.g., macOS default Clang) */
#define MACRO_DIM_ODOMETER_PAR(N_THREADS, DOCODE, GETX, GETY) \\
MACRO_DIM_ODOMETER_SEQ(DOCODE, GETX, GETY)
#endif
"
fun_old <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_old, rng = false)]]
SEXP rcpp_bc_dec_old(
SEXP x, SEXP y,
SEXP x_dim, SEXP y_dim,
SEXP out_dim, R_xlen_t nout
) {
NumericVector out(no_init(nout));
double *pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_ODOMETER_SEQ(
pout[flatind_out] = tempx + tempy,
const double tempx = px[flatind_x],
const double tempy = py[flatind_y]
);
return out;
}
"
fun_new <- "
// [[Rcpp::plugins(openmp)]]
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_new, rng = false)]]
SEXP rcpp_bc_dec_new(
SEXP x, SEXP y,
SEXP x_dim, SEXP y_dim,
SEXP out_dim, R_xlen_t nout, int N_THREADS
) {
NumericVector out(no_init(nout));
double *pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_ODOMETER_PAR(
N_THREADS,
pout[flatind_out] = tempx + tempy,
const double tempx = px[flatind_x],
const double tempy = py[flatind_y]
);
return out;
}
"
