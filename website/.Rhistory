module <- df$name
tinytheme("minimal")
tinyplot(
df$i, df$median, by = module, type = "l",
main = "benchmarks",
xlab = "size of each dimension",
ylab = "median time (ms)"
)
tinyplot_add(
min = df$q1, ymax = df$q3, by = module,
type = type_ribbon(alpha = 0.25)
)
