{
cost = 0;
}
else
{
cost = 1;
}
d[i][j] = std::min(
d[i-1][j] + 1,                // deletion
std::min(d[i][j-1] + 1,       // insertion
d[i-1][j-1] + cost)  // substitution
);
if(
(i > 1) && (j > 1) && (s1[i-1] == s2[j-2]) && (s1[i-2] == s2[j-1])
)
{
d[i][j] = std::min(
d[i][j],
d[i-2][j-2] + cost        // transposition
);
}
}
}
return d[n][m];
}
