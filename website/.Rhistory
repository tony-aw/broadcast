out[0] = out1;
out[1] = out2;
return out;
}
"
Rcpp::sourceCpp(code = paste0(header, inlines, odometer_helper_old, macro_old, fun_old, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, inlines, odometer_helper_new, macro_new, fun_new, collapse = "\n"))
library(broadcast)
# test big vector mode ====
x <- array(rnorm(100), c(10, 10, 10, 10))
y <- array(rnorm(100), c(10, 10, 10, 10))
x.dim <- c(dim(x), rep(1L, 16L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 16L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <-  broadcast:::.C_make_dcp(y.dim)
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 16L - length(out.dim)))
out.len <- prod(out.dim)
old = rcpp_bc_old(x.dim, y.dim, out.dim, out.len)
new = rcpp_bc_new(x.dim, y.dim, out.dim, out.len)
compare <- do.call(cbind, c(old, new))
tinytest::expect_equal(
old, new
) |> print()
# test overflowed orthovector mode ====
