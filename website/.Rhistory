ikw.bilateral <- function(x) {
if(!is.numeric(x) && !is.list(x)) {
stop("cannot apply bilateral indexing keyword on this object")
}
return(
structure(x, class = "ikw.bilateral")
)
}
unkeyword <- function(x) {
return(unclass(x))
}
.bi <- ikw.bilateral(0L)
.bi
