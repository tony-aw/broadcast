d[i][j] = d[i - 1][j - 1];  // no operation
} else {
d[i][j] = std::min(
d[i - 1][j] + 1,    //a deletion
std::min(
d[i][j - 1] + 1,   //an insertion
d[i - 1][j - 1] + 1
)
); //a substitution
} // end if
} // end inner for
} // end outer for
return d[n][m];
}
"
