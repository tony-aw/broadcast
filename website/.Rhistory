int *pi_x = INTEGER(i_x); \\
int *pi_y = INTEGER(i_y); \\
for(int iter16 = 0; iter16 <N16; ++iter16) {	\\
pi_x[15] = pby_x[15] * iter16 * pdcp_x[15];	\\
pi_y[15] = pby_y[15] * iter16 * pdcp_y[15];	\\
for(int iter15 = 0; iter15 <N15; ++iter15) {	\\
pi_x[14] = pby_x[14] * iter15 * pdcp_x[14];	\\
pi_y[14] = pby_y[14] * iter15 * pdcp_y[14];	\\
for(int iter14 = 0; iter14 <N14; ++iter14) {	\\
pi_x[13] = pby_x[13] * iter14 * pdcp_x[13];	\\
pi_y[13] = pby_y[13] * iter14 * pdcp_y[13];	\\
for(int iter13 = 0; iter13 <N13; ++iter13) {	\\
pi_x[12] = pby_x[12] * iter13 * pdcp_x[12];	\\
pi_y[12] = pby_y[12] * iter13 * pdcp_y[12];	\\
for(int iter12 = 0; iter12 <N12; ++iter12) {	\\
pi_x[11] = pby_x[11] * iter12 * pdcp_x[11];	\\
pi_y[11] = pby_y[11] * iter12 * pdcp_y[11];	\\
for(int iter11 = 0; iter11 <N11; ++iter11) {	\\
pi_x[10] = pby_x[10] * iter11 * pdcp_x[10];	\\
pi_y[10] = pby_y[10] * iter11 * pdcp_y[10];	\\
for(int iter10 = 0; iter10 <N10; ++iter10) {	\\
pi_x[9] = pby_x[9] * iter10 * pdcp_x[9];	\\
pi_y[9] = pby_y[9] * iter10 * pdcp_y[9];	\\
for(int iter9 = 0; iter9 <N9; ++iter9) {	\\
pi_x[8] = pby_x[8] * iter9 * pdcp_x[8];	\\
pi_y[8] = pby_y[8] * iter9 * pdcp_y[8];	\\
for(int iter8 = 0; iter8 <N8; ++iter8) {	\\
pi_x[7] = pby_x[7] * iter8 * pdcp_x[7];	\\
pi_y[7] = pby_y[7] * iter8 * pdcp_y[7];	\\
for(int iter7 = 0; iter7 <N7; ++iter7) {	\\
pi_x[6] = pby_x[6] * iter7 * pdcp_x[6];	\\
pi_y[6] = pby_y[6] * iter7 * pdcp_y[6];	\\
for(int iter6 = 0; iter6 <N6; ++iter6) {	\\
pi_x[5] = pby_x[5] * iter6 * pdcp_x[5];	\\
pi_y[5] = pby_y[5] * iter6 * pdcp_y[5];	\\
for(int iter5 = 0; iter5 <N5; ++iter5) {	\\
pi_x[4] = pby_x[4] * iter5 * pdcp_x[4];	\\
pi_y[4] = pby_y[4] * iter5 * pdcp_y[4];	\\
for(int iter4 = 0; iter4 <N4; ++iter4) {	\\
pi_x[3] = pby_x[3] * iter4 * pdcp_x[3];	\\
pi_y[3] = pby_y[3] * iter4 * pdcp_y[3];	\\
for(int iter3 = 0; iter3 <N3; ++iter3) {	\\
pi_x[2] = pby_x[2] * iter3 * pdcp_x[2];	\\
pi_y[2] = pby_y[2] * iter3 * pdcp_y[2];	\\
for(int iter2 = 0; iter2 <N2; ++iter2) {	\\
pi_x[1] = pby_x[1] * iter2 * pdcp_x[1];	\\
pi_y[1] = pby_y[1] * iter2 * pdcp_y[1];	\\
for(int iter1 = 0; iter1 <N1; ++iter1) {	\\
flatind_x =  pby_x[0] * iter1;  \\
flatind_y = pby_y[0] * iter1; \\
for(int i = 1; i < ndim; ++i) {  \\
flatind_x += pi_x[i]; \\
flatind_y += pi_y[i]; \\
} \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
}	\\
} while(0)
//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_plus_static)]]
SEXP rcpp_plus_static(
SEXP x, SEXP y,
SEXP dcp_x, SEXP dcp_y, SEXP by_x, SEXP by_y, R_xlen_t nout, SEXP out_dim, int ndim
) {
double tempout;
SEXP out = PROTECT(Rf_allocVector(REALSXP, nout));
double *pout;
pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_STATIC(pout[flatind_out] = px[flatind_x] + py[flatind_y]);
UNPROTECT(1);
return out;
}
"
Rcpp::cppFunction(code)
