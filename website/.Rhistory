checkmissing <- function(x, op, inv) {
if(is.raw(x)) {
stop("unsupported type for `x` given")
}
if(!is.atomic(x) && !is.list(x)) {
stop("unsupported type for `x` given")
}
if(!is.character(op) || length(op) != 1L) {
stop("`op` must be a single string")
}
if(!isTRUE(inv) && ! isFALSE(inv)) {
stop("`inv` must be `TRUE` or `FALSE`")
}
if(op == "any") {
return(rcpp_checkmissing_any(x, inv))
}
if(op == "all") {
return(rcpp_checkmissing_any(x, !inv))
}
if(op == "logical") {
out <- logical(length(x))
rcpp_checkmissing_setlogical(out, x, inv)
return(out)
}
if(op == "raw") {
out <- raw(length(x))
rcpp_checkmissing_setraw(out, x, inv)
return(out)
}
if(op == "count") {
rcpp_checkmissing_count(x, inv)
}
if(op == "which") {
count <- rcpp_checkmissing_count(x, inv)
intmax <- 2^31 - 1L
if(length(x) < intmax) {
return(rcpp_checkmissing_which32(x, inv, count))
}
else {
return(rcpp_checkmissing_which64(x, inv, count))
}
}
else {
stop("unsupported operator given")
}
}
