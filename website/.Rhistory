header <- "
#include <Rcpp/Lightest>
using namespace Rcpp;
"
macro_4 <- "
#define MACRO_DIM_4(DOCODE) do {      \\
R_xlen_t flatind_out = 0;         \\
const int *pby_x = INTEGER_RO(by_x);        \\
const int *pby_y = INTEGER_RO(by_y);        \\
const double *pdcp_x = REAL_RO(dcp_x);        \\
const double *pdcp_y = REAL_RO(dcp_y);        \\
const int N1 = INTEGER_RO(out_dim)[0];	\\
const int N2 = INTEGER_RO(out_dim)[1];	\\
const int N3 = INTEGER_RO(out_dim)[2];	\\
const int N4 = INTEGER_RO(out_dim)[3];	\\
\\
R_xlen_t flatind_x;       \\
R_xlen_t flatind_y;       \\
R_xlen_t i_x2, i_x3, i_x4; \\
R_xlen_t i_y2, i_y3, i_y4; \\
for(int iter4 = 0; iter4 <N4; ++iter4) {	\\
i_x4 = pby_x[3] * iter4 * pdcp_x[3];	\\
i_y4 = pby_y[3] * iter4 * pdcp_y[3];	\\
for(int iter3 = 0; iter3 <N3; ++iter3) {	\\
i_x3 = pby_x[2] * iter3 * pdcp_x[2] + i_x4;	\\
i_y3 = pby_y[2] * iter3 * pdcp_y[2] + i_y4;	\\
for(int iter2 = 0; iter2 <N2; ++iter2) {	\\
i_x2 = pby_x[1] * iter2 * pdcp_x[1] + i_x3;	\\
i_y2 = pby_y[1] * iter2 * pdcp_y[1] + i_y3;	\\
for(int iter1 = 0; iter1 <N1; ++iter1) {	\\
\\
\\
flatind_x = pby_x[0] * iter1 + i_x2;       \\
flatind_y = pby_y[0] * iter1 + i_y2;     \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
} while(0)
"
macro_fo <- "
#define MACRO_DIM_FULLORTHO(DOCODE) do {      \\
R_xlen_t flatind_out = 0;         \\
const long long *pstrides = strides.data();        \\
const R_xlen_t N1 = INTEGER_RO(out_dim)[0];	\\
const R_xlen_t N2 = INTEGER_RO(out_dim)[1] * pstrides[1];	\\
const R_xlen_t N3 = INTEGER_RO(out_dim)[2] * pstrides[2];	\\
const R_xlen_t N4 = INTEGER_RO(out_dim)[3] * pstrides[3];	\\
\\
R_xlen_t flatind_x;       \\
R_xlen_t flatind_y;       \\
R_xlen_t i_x3; \\
R_xlen_t i_y2, i_y4; \\
for(R_xlen_t iter4 = 0; iter4 <N4; iter4 += pstrides[3]) {	\\
i_y4 = iter4;	\\
for(R_xlen_t iter3 = 0; iter3 <N3; iter3 += pstrides[2]) {	\\
i_x3 = iter3;	\\
for(R_xlen_t iter2 = 0; iter2 <N2; iter2 += pstrides[1]) {	\\
i_y2 = iter2 + i_y4;	\\
for(R_xlen_t iter1 = 0; iter1 <N1; ++iter1) {	\\
\\
\\
flatind_x = iter1 + i_x3;       \\
flatind_y = i_y2 + i_y4;     \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
} while(0)
"
macro_fo2 <- "
#define MACRO_DIM_FULLORTHO(DOCODE) do {      \\
R_xlen_t flatind_out = 0;         \\
const long long *pstrides = strides.data();        \\
const int N = INTEGER_RO(out_dim)[0];  \\
\\
R_xlen_t flatind_x;       \\
R_xlen_t flatind_y;       \\
R_xlen_t i_x3; \\
R_xlen_t i_y2, i_y4; \\
for(int iter4 = 0; iter4 <N; ++iter4) {	\\
i_y4 = iter4 * pstrides[3];	\\
for(int iter3 = 0; iter3 <N; ++iter3) {	\\
i_x3 = iter3 * pstrides[2];	\\
for(int iter2 = 0; iter2 <N; ++iter2) {	\\
i_y2 = iter2 * pstrides[1] + i_y4 ;	\\
for(int iter1 = 0; iter1 <N; ++iter1) {	\\
\\
\\
flatind_x = iter1 + i_x3;       \\
flatind_y = i_y2 + i_y4;     \\
\\
DOCODE;                                                          \\
\\
flatind_out++;                      \\
}	\\
}	\\
}	\\
}	\\
} while(0)
"
fun_d <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_d, rng = false)]]
SEXP rcpp_bc_dec_d(
SEXP x, SEXP y,
SEXP by_x,
SEXP by_y,
SEXP dcp_x, SEXP dcp_y, SEXP out_dim, R_xlen_t nout
) {
double tempout;
SEXP out = PROTECT(Rf_allocVector(REALSXP, nout));
double *pout;
pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_4(px[flatind_x] + py[flatind_y]);
UNPROTECT(1);
return out;
}
"
fun_fo <- "
//' @keywords internal
//' @noRd
// [[Rcpp::export(.rcpp_bc_dec_fo, rng = false)]]
SEXP rcpp_bc_dec_fo(
SEXP x, SEXP y,
const std::vector<long long> strides,
SEXP out_dim, R_xlen_t nout
) {
double tempout;
SEXP out = PROTECT(Rf_allocVector(REALSXP, nout));
double *pout;
pout = REAL(out);
const double *px = REAL_RO(x);
const double *py = REAL_RO(y);
MACRO_DIM_FULLORTHO(px[flatind_x] + py[flatind_y]);
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = paste0(header, macro_4, fun_d, collapse = "\n"))
Rcpp::sourceCpp(code = paste0(header, macro_fo2, fun_fo, collapse = "\n"))
# RUN BENCH ====
ndim <- broadcast::ndim
n <- 90
x <- array(rnorm(100), c(n, 1, n, 1))
y <- array(rnorm(100), c(1, n, 1, n))
x.dim <- c(dim(x), rep(1L, 4L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 4L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <-  broadcast:::.C_make_dcp(y.dim)
stride_x <- by_x * dcp_x[1:4]
stride_y <- by_y * dcp_y[1:4]
strides <- pmax(stride_x, stride_y)
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 4L - length(out.dim)))
out.len <- prod(out.dim)
invisible(gc())
foo <- bench::mark(
d4 = .rcpp_bc_dec_d(x, y, by_x, by_y, dcp_x, dcp_y, out.dim, out.len),
fo = .rcpp_bc_dec_fo(x, y, strides, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
invisible(gc())
foo <- bench::mark(
fo = .rcpp_bc_dec_fo(x, y, strides, out.dim, out.len),
d4 = .rcpp_bc_dec_d(x, y, by_x, by_y, dcp_x, dcp_y, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
Rcpp::sourceCpp(code = paste0(header, macro_fo, fun_fo, collapse = "\n"))
invisible(gc())
foo <- bench::mark(
d4 = .rcpp_bc_dec_d(x, y, by_x, by_y, dcp_x, dcp_y, out.dim, out.len),
fo = .rcpp_bc_dec_fo(x, y, strides, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
invisible(gc())
foo <- bench::mark(
fo = .rcpp_bc_dec_fo(x, y, strides, out.dim, out.len),
d4 = .rcpp_bc_dec_d(x, y, by_x, by_y, dcp_x, dcp_y, out.dim, out.len),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
