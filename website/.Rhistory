ndim <- broadcast::ndim
n <- 85
x <- array(1:100, c(n, 1, n, 1))
y <- array(1:100, c(1, n, 1, n))
x.dim <- c(dim(x), rep(1L, 4L - ndim(x)))
y.dim <- c(dim(y), rep(1L, 4L - ndim(y)))
by_x <- broadcast:::.C_make_by(x.dim)
by_y <- broadcast:::.C_make_by(y.dim)
dcp_x <- broadcast:::.C_make_dcp(x.dim)
dcp_y <-  broadcast:::.C_make_dcp(y.dim)
stride_x <- by_x * dcp_x[1:4]
stride_y <- by_y * dcp_y[1:4]
out.dim <- broadcast::bc_dim(x, y)
out.dim <- c(out.dim, rep(1L, 4L - length(out.dim)))
out.len <- prod(out.dim)
invisible(gc())
foo <- bench::mark(
old = .rcpp_bc_dec_old(x, y, by_x, by_y, dcp_x, dcp_y, out.dim, out.len),
new = .rcpp_bc_dec_new(x, y, stride_x, stride_y, out.dim, out.len),
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
invisible(gc())
