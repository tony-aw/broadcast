aman <- function(x, sub, rp) {
x.dim <- dim(x)
x.ndim <- length(x.dim)
dim(x) <- c(dim(x), rep(1L, 4 - x.ndim))
sub <- c(sub, rep(list(1L), 4 - x.ndim))
x[sub[[1]], sub[[2]], sub[[3]], sub[[4]]] <- rp
dim(x) <- x.dim
return(x)
}
