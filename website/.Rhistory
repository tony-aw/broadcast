code1 <- "
int rcpp_str_dist_led1(String x, String y) {
if(x == NA_STRING || y == NA_STRING) {
return NA_INTEGER;
}
std::string s1 = x;
std::string s2 = y;
// Number of elements
int n = s1.size();
int m = s2.size();
int nrow = n + 1;
int ncol = m + 1;
std::vector<int> d(nrow * ncol, 0);
if (n == 0){
return m;
}
if (m == 0){
return n;
}
for (int i = 0; i < nrow; i++){
d[i] = i;
}
for (int j = 1; j < ncol; j++){
d[nrow * j] = j;
}
for (int j = 1; j <= m; j++){
for (int i = 1; i <= n; i++){
if (s1[i - 1] == s2[j - 1]){
d[i + nrow * j] = d[(i - 1) + nrow * (j - 1)];  // no operation
} else {
d[i + nrow * j] = std::min(
d[(i - 1) + nrow * j] + 1,    //a deletion
std::min(
d[i + nrow * (j - 1)] + 1,   //an insertion
d[(i - 1) + nrow * (j - 1)] + 1
)
); //a substitution
} // end if
} // end inner for
} // end outer for
return d[n + nrow * m];
}
"
