sim <- matrix(rnorm(1000*5000), 1000, 5000)
sim2 <- as.data.frame(sim)
y <- rnorm(1000)
foo <- bench::mark(
ecp_mat = ecumprob(y, sim),
ecp_df = ecumprob(y, sim2),
ecp_conv = ecumprob(y, as.matrix(sim2)),
min_iterations = 500
)
summary(foo)
plot(foo)
