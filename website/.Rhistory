x <- array(1:10, c(10, 1, 8, 1, 10))
y <- array(1:10, c(10, 9, 1, 9, 10))
dimx <- dim(x)
dimy <- dim(y)
foo <- data.frame(
i = 1:5,
`dim(x)[i]` = c(dimx, NA),
`dim(y)[i]` = dimy,
orthogonal = c(FALSE, rep(TRUE, 4L), FALSE),
reason = c("dim(x)[i] == dim(y)[i]", rep("dim(x)[i] != dim(y)[i]", 4), "dim(x)[i] == dim(y)[i]"),
check.names = FALSE
)
foo <- data.frame(
i = 1:5,
`dim(x)[i]` = dimx,
`dim(y)[i]` = dimy,
orthogonal = c(FALSE, rep(TRUE, 4L), FALSE),
reason = c("dim(x)[i] == dim(y)[i]", rep("dim(x)[i] != dim(y)[i]", 4), "dim(x)[i] == dim(y)[i]"),
check.names = FALSE
)
