// [[Rcpp::export(rcpp_bc_int_bigxv_test2)]]
SEXP rcpp_bc_int_bigxv_test2(
SEXP x, SEXP y, SEXP out_dim, R_xlen_t nout, int iterw
) {
const int *px = INTEGER_RO(x);
const int *py = INTEGER_RO(y);
int tempout;
SEXP out = PROTECT(Rf_allocVector(INTSXP, nout));
int *pout = INTEGER(out);
std::vector<int> iter(5); // using std::vector because R vector seemed too slow
iter[0] = 0;
iter[0] = 0;
iter[1] = 0;
iter[2] = 0;
iter[3] = 0;
iter[4] = 0;
int counterw = 0;
R_xlen_t countero = 0;
const int *pout_dim = INTEGER_RO(out_dim);
for(; iter[4] < pout_dim[4]; ++iter[4]) {
for(; iter[3] < pout_dim[2]; ++iter[3]) {
for(; iter[2] < pout_dim[1]; ++iter[2]) {
for(; iter[1] < pout_dim[0]; ++iter[1]) {
counterw = iter[iterw];
tempout = px[countero] + py[counterw];
pout[countero] = tempout;
countero++;
}
}
}
}
UNPROTECT(1);
return out;
}
"
Rcpp::sourceCpp(code = code)
n <- 75L
a <- array(sample(1:100), c(n, n, n, n))
b <- array(sample(1:100), c(1, n, 1, 1))
by_a <- ifelse(dim(a) > 1L, 1L, 0L)
by_b <- ifelse(dim(b) > 1L, 1L, 0L)
s_a <- list(1:n, 1:n, 1:n)
s_b <- list(1:n, 1:n, rep(1L, n))
dcp_a <- c(1, cumprod(dim(a)))
dcp_b <- c(1, cumprod(dim(b)))
out.dim <- pmax(dim(a), dim(b))
out.len <- prod(out.dim)
gc()
foo <- bench::mark(
test_spmat = rcpp_bc_int_bigxv_test2(a, b, out.dim, out.len, 2L),
test_regular = rcpp_bc_int_d_test(a, b, by_a, by_b, dcp_a, dcp_b, out.dim, out.len),
check = FALSE,
min_iterations = 100,
)
summary(foo)
ggplot2::autoplot(foo)
# speed tests
library(broadcast)
n <- 100L
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, n, 1L)
npb <- np$random$rand(1L, n, 1L)
npa + npb
a <- array(rnorm(100), c(n, n, 1L))
b <- array(rnorm(100), c(1L, n, 1L))
broadcaster(a) <- broadcaster(b) <- TRUE
gc()
foo <- bench::mark(
bc = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 100,
)
summary(foo)
ggplot2::autoplot(foo)
62/44
