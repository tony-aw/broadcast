# set-up ====
library(collapse)
library(abind)
library(broadcast)
# cbind/rbind ====
n <- 110L
nms <- function(n) sample(letters, n, TRUE)
x <- array(as.double(1:25), c(n, n, n))
y <- array(as.double(-1:-25), c(n, n, n))
dimnames(x) <- lapply(dim(x), nms)
dimnames(y) <- lapply(dim(y), nms)
input <- list(x, y, x)
gc()
bm_abind <- bench::mark(
cbind = do.call(cbind, input),
broadcast = bind_array(input, 2),
min_iterations = 100,
check = FALSE # because abind adds empty dimnames
)
bm_cbind <- bm_abind
summary(bm_cbind)
ggplot2::autoplot(bm_cbind)
input <- rep(list(as.array(1:100)), 100L)
gc()
bm_cbind <- bench::mark(
cbind = do.call(cbind, input),
broadcast = bind_array(input, 2),
min_iterations = 100,
check = FALSE # because abind adds empty dimnames
)
summary(bm_cbind)
ggplot2::autoplot(bm_cbind)
input <- rep(list(as.array(1:100)), 500L)
gc()
bm_cbind <- bench::mark(
cbind = do.call(cbind, input),
broadcast = bind_array(input, 2),
min_iterations = 100,
check = FALSE # because abind adds empty dimnames
)
summary(bm_cbind)
ggplot2::autoplot(bm_cbind)
# bind a few large arrays====
n <- 110L
nms <- function(n) sample(letters, n, TRUE)
x <- array(as.double(1:25), c(n, n, n))
y <- array(as.double(-1:-25), c(n, n, n))
dimnames(x) <- lapply(dim(x), nms)
dimnames(y) <- lapply(dim(y), nms)
input <- list(x, y, x)
gc()
bm_abind <- bench::mark(
abind = abind::abind(input, along = 2),
broadcast = bind_array(input, 2),
min_iterations = 100,
check = FALSE # because abind adds empty dimnames
)
summary(bm_abind)
ggplot2::autoplot(bm_abind)
