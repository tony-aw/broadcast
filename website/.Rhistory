library(broadcast)
n <- 20L
a <- array(rnorm(100), c(n, 1L, n))
a.dim <- dim(a)
b <- array(rnorm(100), c(n, n, 1))
b.dim <- dim(b)
by_a <- ifelse(dim(a) > 1L, 1L, 0L)
by_b <- ifelse(dim(b) > 1L, 1L, 0L)
s_a <- list(1:n, 1:n, 1:n)
s_b <- list(1:n, 1:n, rep(1L, n))
dcp_a <- c(1, cumprod(dim(a)))
dcp_b <- c(1, cumprod(dim(b)))
out.dim <- pmax(dim(a), dim(b))
out.len <- prod(out.dim)
a.len <- length(a)
b.len <- length(b)
mergedims <- function(x.dim, y.dim) {
if(length(x.dim) > 2L && length(y.dim) > 2L) {
mergeable <- broadcast:::.rcpp_is_mergeable_with_prev(x.dim == 1L, y.dim == 1L)
if(any(mergeable)) {
mergedims <- broadcast:::.rcpp_mergedims(x.dim, y.dim, mergeable)
x.dim <- mergedims[[1L]]
y.dim <- mergedims[[2L]]
}
}
}
nullify_dims <- function(x, y) {
x.dim <- dim(x)
y.dim <- dim(y)
x.len <- length(x)
y.len <- length(y)
if(!is.null(x.dim) || !is.null(y.dim)) {
if(is.null(x.dim)) x.dim <- x.len
if(is.null(y.dim)) y.dim <- y.len
}
}
normalize_dims <- function(x.dim, y.dim) {
if(!is.null(x.dim) && !is.null(y.dim)) {
xndim <- length(x.dim)
yndim <- length(y.dim)
if(xndim > yndim) {
y.dim <- c(y.dim, rep(1L, xndim - yndim))
}
if(yndim > xndim) {
x.dim <- c(x.dim, rep(1L, yndim - xndim))
}
}
}
drop_commons <- function(x.dim, y.dim) {
if(length(x.dim) > 1L && length(y.dim) > 1L) {
drop.count <- broadcast:::.C_dropdims_count(x.dim, y.dim)
if(drop.count > 0L) {
drop.ind <- broadcast:::.C_dropdims_which(x.dim, y.dim, drop.count)
x.dim <- x.dim[-drop.ind]
y.dim <- y.dim[-drop.ind]
}
if(length(x.dim) == 0L) x.dim <- NULL
if(length(y.dim) == 0L) y.dim <- NULL
} # end dropping dimensions
}
