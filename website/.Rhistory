# speed tests
library(broadcast)
# sw2v ====
n <- 31L
print(n^4 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
# sw2v ====
n <- 31L
print(n^4 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, 1L, 1L, n)
npb <- np$random$rand(1L, n, n, 1L)
a <- array(rnorm(100), c(n, 1L, 1L, n))
b <- array(rnorm(100), c(1L, n, n, 1L))
broadcaster(a) <- broadcaster(b) <- TRUE
gc()
foo <- bench::mark(
bc.op = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 100,
)
summary(foo)
plot(foo)
gc()
# regular ====
