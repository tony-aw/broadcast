code <- "
#include <Rcpp.h>
#include <Rinternals.h>
#include <unordered_map>
#include <vector>
#include <utility>
#include <string>
using namespace Rcpp;
// [[Rcpp::plugins(cpp11)]]
// 1. Custom Equality Functor using R_compute_identical()
struct RIdenticalKeyEq {
bool operator()(const SEXP& lhs, const SEXP& rhs) const {
// Safe evaluation across different string encodings or NA markers
// return R_compute_identical(lhs, rhs, 0);
return lhs == rhs;
}
};
// 2. Safe Custom Hash Functor using standard string hashing
struct RStringHash {
std::size_t operator()(const SEXP& s) const {
// Direct read access to the underlying null-terminated char array
return std::hash<std::string>{}(R_CHAR(s));
}
};
// [[Rcpp::export]]
SEXP rcpp_match_names(SEXP needles, SEXP haystack) {
int n_haystack = Rf_length(haystack);
int n_needles = Rf_length(needles);
const SEXP* p_haystack = STRING_PTR_RO(haystack);
const SEXP* p_needles = STRING_PTR_RO(needles);
// Explicitly initialize maps using the custom hash and equality logic
std::unordered_map<SEXP, int, RStringHash, RIdenticalKeyEq> counts;
counts.reserve(n_haystack / 2);
for (int j = 0; j < n_haystack; ++j) {
counts[p_haystack[j]]++;
}
std::unordered_map<SEXP, std::pair<int, int>, RStringHash, RIdenticalKeyEq> haystack_map;
haystack_map.reserve(counts.size());
std::vector<int> flat_indices(n_haystack);
int current_offset = 0;
for (auto const& x : counts) {
haystack_map[x.first] = {current_offset, 0};
current_offset += x.second;
}
for (int j = 0; j < n_haystack; ++j) {
SEXP str = p_haystack[j];
if (str != NA_STRING) {
auto& boundary = haystack_map[str];
flat_indices[boundary.first + boundary.second] = j + 1;
boundary.second++;
}
}
// --- Step 3: First Pass on Needles ---
double total_matches = 0;
for (int i = 0; i < n_needles; ++i) {
SEXP needle = p_needles[i];
if (needle == NA_STRING) {
stop(\"NAs not allowed\");
}
auto it = haystack_map.find(needle);
if (it == haystack_map.end()) {
stop(\"unknown names given\");
}
total_matches += it->second.second;
}
// --- Step 4: Output Structure Allocation and Vector Population ---
SEXP ans;
bool use_double = (total_matches >= (std::pow(2, 31) - 1));
if (use_double) {
ans = PROTECT(Rf_allocVector(REALSXP, (R_xlen_t)total_matches));
double* p_ans = REAL(ans);
R_xlen_t idx = 0;
for (int i = 0; i < n_needles; ++i) {
auto const& boundary = haystack_map[p_needles[i]];
int start = boundary.first;
int count = boundary.second;
for (int k = 0; k < count; ++k) {
p_ans[idx++] = (double)flat_indices[start + k];
}
}
} else {
ans = PROTECT(Rf_allocVector(INTSXP, (R_xlen_t)total_matches));
int* p_ans = INTEGER(ans);
R_xlen_t idx = 0;
for (int i = 0; i < n_needles; ++i) {
auto const& boundary = haystack_map[p_needles[i]];
int start = boundary.first;
int count = boundary.second;
for (int k = 0; k < count; ++k) {
p_ans[idx++] = flat_indices[start + k];
}
}
}
UNPROTECT(1);
return ans;
}
"
Rcpp::sourceCpp(code = code)
# bm duplicate haystack ====
haystack <- sample(nms, 5e6, TRUE)
needles <- sample(nms)
bm <- bench::mark(
rcpp = rcpp_match_names(needles, haystack),
sb = squarebrackets:::.match_names(needles, haystack, FALSE, sys.call()),
# base = lapply(needles, \(i) which(haystack == i)) |> unlist(),
min_iterations = 100
)
summary(bm)
plot(bm)
code <- "
#include <Rcpp.h>
#include <unordered_map>
#include <vector>
#include <string>
using namespace Rcpp;
// [[Rcpp::plugins(cpp11)]]
// Snelle string-hash op basis van de daadwerkelijke karakterdata
inline std::size_t hash_string_content(SEXP s) {
return std::hash<std::string>{}(R_CHAR(s));
}
// [[Rcpp::export]]
SEXP fast_hash_match_which(SEXP haystack, SEXP needles) {
// 1. Gebruik R_xlen_t voor 64-bit vector lengtes
R_xlen_t n_haystack = Rf_xlength(haystack);
R_xlen_t n_needles = Rf_xlength(needles);
const SEXP* p_haystack = STRING_PTR_RO(haystack);
const SEXP* p_needles = STRING_PTR_RO(needles);
// 2. Bepaal de grootte van de platte hashtabel in 64-bit ruimte
std::size_t table_size = 1;
// Gebruik (std::size_t) om vermenigvuldiging veilig in 64-bit uit te voeren
while (table_size < (std::size_t)n_haystack * 2) {
table_size <<= 1;
// Beveiliging tegen extreme overloop van de 64-bit container (theoretisch)
if (table_size == 0) {
stop(\"Haystack is te groot om in de hashtabel te passen.\");
}
}
std::size_t mask = table_size - 1;
// De tabel slaat paren op: {String_SEXP, Aantal_Voorkomens (64-bit)}
std::vector<std::pair<SEXP, R_xlen_t>> counts_table(table_size, {nullptr, 0});
// --- Stap 1: Vul de hashtabel met frequenties ---
for (R_xlen_t j = 0; j < n_haystack; ++j) {
SEXP str = p_haystack[j];
if (str == NA_STRING) continue;
std::size_t idx = hash_string_content(str) & mask;
while (counts_table[idx].first != nullptr &&
!R_compute_identical(counts_table[idx].first, str, 0)) {
idx = (idx + 1) & mask;
}
if (counts_table[idx].first == nullptr) {
counts_table[idx].first = str;
}
counts_table[idx].second++;
}
// --- Stap 2: Bouw de aaneengesloten index-omgeving ---
// Slaat op: {String_SEXP, {start_offset (64-bit), teller (64-bit)}}
std::vector<std::pair<SEXP, std::pair<R_xlen_t, R_xlen_t>>> haystack_map(table_size, {nullptr, {0, 0}});
// Omdat de indices in de haystack de 2^31-1 kunnen passeren, gebruiken we double voor flat_indices
std::vector<double> flat_indices(n_haystack);
R_xlen_t current_offset = 0;
for (std::size_t i = 0; i < table_size; ++i) {
if (counts_table[i].first != nullptr) {
SEXP str = counts_table[i].first;
R_xlen_t count = counts_table[i].second;
std::size_t idx = hash_string_content(str) & mask;
while (haystack_map[idx].first != nullptr) {
idx = (idx + 1) & mask;
}
haystack_map[idx] = {str, {current_offset, 0}};
current_offset += count;
}
}
// Vul de platte index-registry met 1-based posities (als double)
for (R_xlen_t j = 0; j < n_haystack; ++j) {
SEXP str = p_haystack[j];
if (str != NA_STRING) {
std::size_t idx = hash_string_content(str) & mask;
while (!R_compute_identical(haystack_map[idx].first, str, 0)) {
idx = (idx + 1) & mask;
}
auto& boundary = haystack_map[idx].second;
flat_indices[boundary.first + boundary.second] = (double)(j + 1);
boundary.second++;
}
}
// --- Stap 3: Eerste pass over Needles (Tellen & Error Check) ---
double total_matches = 0; // double voorkomt overflow bij het tellen van resultaten > 2^31-1
for (R_xlen_t i = 0; i < n_needles; ++i) {
SEXP needle = p_needles[i];
if (needle == NA_STRING) {
stop(\"needle op index is NA, deze kan niet matchen met de haystack\");
}
std::size_t idx = hash_string_content(needle) & mask;
while (haystack_map[idx].first != nullptr &&
!R_compute_identical(haystack_map[idx].first, needle, 0)) {
idx = (idx + 1) & mask;
}
if (haystack_map[idx].first == nullptr) {
stop(\"needle op index heeft geen matches in de haystack\");
}
total_matches += (double)haystack_map[idx].second.second;
}
// --- Stap 4: Allocatie en Vullen van het R resultaat ---
SEXP ans;
bool use_double = (total_matches > 2147483647.0);
if (use_double) {
ans = PROTECT(Rf_allocVector(REALSXP, (R_xlen_t)total_matches));
double* p_ans = REAL(ans);
R_xlen_t res_idx = 0;
for (R_xlen_t i = 0; i < n_needles; ++i) {
std::size_t idx = hash_string_content(p_needles[i]) & mask;
while (!R_compute_identical(haystack_map[idx].first, p_needles[i], 0)) {
idx = (idx + 1) & mask;
}
auto const& boundary = haystack_map[idx].second;
R_xlen_t start = boundary.first;
R_xlen_t count = boundary.second;
for (R_xlen_t k = 0; k < count; ++k) {
p_ans[res_idx++] = flat_indices[start + k];
}
}
} else {
ans = PROTECT(Rf_allocVector(INTSXP, (R_xlen_t)total_matches));
int* p_ans = INTEGER(ans);
R_xlen_t res_idx = 0;
for (R_xlen_t i = 0; i < n_needles; ++i) {
std::size_t idx = hash_string_content(p_needles[i]) & mask;
while (!R_compute_identical(haystack_map[idx].first, p_needles[i], 0)) {
idx = (idx + 1) & mask;
}
auto const& boundary = haystack_map[idx].second;
R_xlen_t start = boundary.first;
R_xlen_t count = boundary.second;
for (R_xlen_t k = 0; k < count; ++k) {
// Snel en veilig casten naar int omdat we weten dat total_matches < 2^31-1 is
p_ans[res_idx++] = (int)flat_indices[start + k];
}
}
}
UNPROTECT(1);
return ans;
}
"
Rcpp::sourceCpp(code = code)
nms <- c(letters, LETTERS, month.abb, month.name)
needles <- sample(nms, 100, TRUE)
haystack <- sample(nms, 1000, TRUE)
expected <- lapply(needles, \(i) which(haystack == i)) |> unlist()
rcpp_match_names(NA_character_, letters) # NAs now allowed
rcpp_match_names(letters, NA_character_) # unknown names
rcpp_match_names(c("b"), c(letters, NA)) # ignores NAs
out <- rcpp_match_names(needles, haystack)
expect_equal(
expected, out
)
needles <- sample(nms, 2e4, TRUE)
haystack <- sample(nms, 2e5, TRUE)
bm <- bench::mark(
rcpp = rcpp_match_names(needles, haystack),
sb = squarebrackets:::.match_names(needles, haystack, FALSE, sys.call()),
# base = lapply(needles, \(i) which(haystack == i)) |> unlist(),
min_iterations = 100
)
summary(bm)
plot(bm)
needles <- sample(nms, 5e6, TRUE)
haystack <- sample(nms)
bm <- bench::mark(
rcpp = rcpp_match_names(needles, haystack),
sb = squarebrackets:::.match_names(needles, haystack, FALSE, sys.call()),
# base = lapply(needles, \(i) which(haystack == i)) |> unlist(),
min_iterations = 100
)
summary(bm)
plot(bm)
# bm duplicate haystack ====
haystack <- sample(nms, 5e6, TRUE)
needles <- sample(nms)
bm <- bench::mark(
rcpp = rcpp_match_names(needles, haystack),
sb = squarebrackets:::.match_names(needles, haystack, FALSE, sys.call()),
# base = lapply(needles, \(i) which(haystack == i)) |> unlist(),
min_iterations = 100
)
summary(bm)
plot(bm)
