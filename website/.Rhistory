code <- "
int C_int_determine_mode(
SEXP x, SEXP y, int op, SEXP ops32
) {
if(TYEPOF(x) == REALSXP || TYPEOF(y) == REALSXP) {
return Rf_ScalarInteger(2);
}
if(TYPEOF(x) == LGLSXP && TYPEOF(y) == LGLSXP) {
return Rf_ScalarInteger(0);
}
if(TYEPOF(x) == LGLSXP || TYPEOF(y) == LGLSXP) {
int out = 1;
int n = Rf_length(ops32);
const int *restrict pops32 = INTEGER_RO(ops32);
for(int i = 0; i < n; ++i) {
if(op == pops32) {
out = 0;
break;
}
}
return Rf_ScalarInteger(out);
}
if(TYPEOF(x) == INTSXP || TYPEOF(x) == LGLSXP) {
if(TYPEOF(y) == INTSXP || TYPEOF(y) == LGLSXP) {
return Rf_ScalarInteger(1);
}
}
return Rf_ScalarInteger(2);
}
"
body <- "
if(TYEPOF(x) == REALSXP || TYPEOF(y) == REALSXP) {
return Rf_ScalarInteger(2);
}
if(TYPEOF(x) == LGLSXP && TYPEOF(y) == LGLSXP) {
return Rf_ScalarInteger(0);
}
if(TYEPOF(x) == LGLSXP || TYPEOF(y) == LGLSXP) {
int out = 1;
int n = Rf_length(ops32);
const int *restrict pops32 = INTEGER_RO(ops32);
for(int i = 0; i < n; ++i) {
if(op == pops32) {
out = 0;
break;
}
}
return Rf_ScalarInteger(out);
}
if(TYPEOF(x) == INTSXP || TYPEOF(x) == LGLSXP) {
if(TYPEOF(y) == INTSXP || TYPEOF(y) == LGLSXP) {
return Rf_ScalarInteger(1);
}
}
return Rf_ScalarInteger(2);
"
