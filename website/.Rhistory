library(broadcast)
n <- 5000L
print(n^2 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, 1L)
npb <- np$random$rand(1L, n)
a <- array(rnorm(100), c(n, 1L))
b <- array(rnorm(100), c(1L, n))
broadcaster(a) <- broadcaster(b) <- TRUE
gc()
foo <- bench::mark(
bc.op = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 200,
)
