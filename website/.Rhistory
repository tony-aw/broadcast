code <- "
int dl(String x, String y)
{
if(x == NA_STRING || y == NA_STRING) {
return NA_INTEGER;
}
std::string s1 = x;
std::string s2 = y;
int n = s1.size();
int m = s2.size();
int d[n+1][m+1];
int i;
int j;
int cost;
for (i = 0;i <= n; i++)
{
d[i][0] = i;
}
for(j = 0; j<= m; j++)
{
d[0][j] = j;
}
for (i = 1;i <= n;i++)
{
for(j = 1; j<= m; j++)
{
if( s1[i-1] == s2[j-1] )
{
cost = 0;
}
else
{
cost = 1;
}
d[i][j] = std::min(
d[i-1][j] + 1,                // deletion
std::min(d[i][j-1] + 1,       // insertion
d[i-1][j-1] + cost)  // substitution
);
if(
(i > 1) && (j > 1) && (s1[i-1] == s2[j-2]) && (s1[i-2] == s2[j-1])
)
{
d[i][j] = std::min(
d[i][j],
d[i-2][j-2] + cost        // transposition
);
}
}
}
return d[n][m];
}
"
Rcpp::cppFunction(code)
n <- 2e4
x <- sample(month.abb, n, TRUE)
y <- sample(month.name, n, TRUE)
i=
1
stringdist::stringdist(x[i], y[i], method = "dl")
