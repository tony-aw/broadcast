out <- raw(length(x))
rcpp_checkmissing_setraw(out, x, inv)
return(out)
}
if(op == "count") {
rcpp_checkmissing_count(x, inv)
}
if(op == "which") {
count <- rcpp_checkmissing_count(x, inv)
intmax <- 2^31 - 1L
if(length(x) < intmax) {
return(rcpp_checkmissing_which32(x, inv, count))
}
else {
return(rcpp_checkmissing_which64(x, inv, count))
}
}
else {
stop("unsupported operator given")
}
}
