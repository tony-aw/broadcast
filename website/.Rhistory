clippable <- function(txt) {
code_call <- txt
cat("\n# Static code:\n", code_call, "\n\n")
# Zorg dat de code veilig binnen single quotes geplaatst kan worden
safe_text <- gsub("'", "\\'", code_call, fixed = TRUE)
# Bouw het achtergrondcommando op
click_command <- sprintf("utils::writeClipboard('%s'); message('✓ Copied to Clipboard!')", safe_text)
# Haal de pijl (pointer) vooraf op uit cli
ptr <- cli::symbol$pointer
# Maak gebruik van double braces {{ }} om variabelen correct te mixen met cli-markup
cli::cli_text("{.run {{ptr}} [Click here to copy code]( {{click_command}} )}")
cat("\n")
return(invisible(txt))
}
clippable('c("stri_sub", "stri_sub<-", "%s+%")')
