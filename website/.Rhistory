lst <- list(1:4, 1:4, 1:4)
aman(x, lst, -1)
foo <- bench::mark(
aman = aman(x, sub, -1),
mod = ss_mod(x, sub, rp = -1),
min_iterations = 500
)
summary(foo)
ggplot2::autoplot(foo)
