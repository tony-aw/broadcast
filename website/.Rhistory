library(broadcast)
n <- 100L
print(n^3 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, 1L, n)
npb <- np$random$rand(1L, n, 1L)
a <- array(rnorm(100), c(n, 1L, n))
b <- array(rnorm(100), c(1L, n, 1L))
broadcaster(a) <- broadcaster(b) <- TRUE
by_a <- broadcast:::.C_make_by(dim(a))
by_b <- broadcast:::.C_make_by(dim(b))
dcp_a <- broadcast:::.C_make_dcp(a)
dcp_b <- broadcast:::.C_make_dcp(b)
out.dim <- pmax(dim(a), dim(b))
out.len <- prod(out.dim)
gc()
foo <- bench::mark(
bc.op = a + b,
numpy_via_reticulate = npa + npb,
gc = gc(),
check = FALSE,
min_iterations = 200,
)
summary(foo)
plot(foo)
gc()
foo <- bench::mark(
gc = gc(),
bc.op = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 200,
)
summary(foo)
plot(foo)
gc()
