`[<-.ProxyFunction` <- function(proxy_obj, x, ... , value) {
name_of_x <- deparse1(substitute(x), backtick = TRUE)
x_value <- eval(parse(text = name_of_x), envir = parent.frame())
real_fun <- attr(proxy_obj, "real_fun")
updated_x <- real_fun(x_value, ..., value = value)
assign(name_of_x, updated_x, envir = parent.frame())
return(proxy_obj)
}
`[[<-.tinyimport` <- function(env, fun_name, ..., value) {
# 1. Bouw de naam van de functiemethode op
replacement_name <- paste0(substitute(fun_name), "<-")
real_fun <- get(replacement_name, envir = env)
# 2. Haal de argumenten (zoals 'getal') op uit de dots
args <- list(...)
# 3. Achterhaal de exacte NAAM van de variabele die de gebruiker invoerde
# Omdat [[<- een extra interne call-laag heeft, gebruiken we parent.frame(1)
# en substitueren we het eerste element uit de dots.
var_expr <- substitute(...())[[1]]
var_name <- deparse(var_expr)
# 4. Voer de berekening uit
args$value <- value
updated_x <- do.call(real_fun, args)
# 5. Schrijf de nieuwe waarde direct terug in de scope van de gebruiker
assign(var_name, updated_x, envir = parent.frame())
# CRUCIAL: Retourneer de environment zelf, zodat deze NIET overschreven wordt!
return(env)
}
`@.tinyimport` <- function(e1, e2) {
nms <- names(e1)
if(!e2 %in% nms) {
stop(sprintf("%s is not an exported object in alias %s", e2, substitute(e2)))
}
get(e2, envir = e1)
}
.AtNames.tinyimport <- function(x, pattern = "") {
# Omdat het object zelf een environment is, kunnen we direct names() opvragen
alle_namen <- names(x)
grep(pattern, alle_namen, value = TRUE)
}
