# conformalize ====
# x is vector:
x.dim <- rep(1L, 16L)
y.dim <- sample(2:10, 16L, TRUE)
x.len <- 1L
y.len <- prod(y.dim)
x.ndim <- 0L
y.ndim <- 10L
.rcpp_virt_conformalize_test(x.dim, y.dim, x.ndim, y.ndim, x.len, y.len)
expect_equal(
x.dim,
c(x.len, rep(1L, 15L))
)
