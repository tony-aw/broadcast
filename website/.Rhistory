`[<-.ProxyFunction` <- function(proxy_obj, x, ... , value) {
name_of_x <- as.character(substitute(x))
print(name_of_x)
# Veiligheidscheck: is name_of_x wel echt een enkele tekststring?
if (!is.character(name_of_x) || length(name_of_x) != 1) {
stop("Fout: De naam van de variabele moet een character vector van lengte 1 zijn.")
}
# 2. Haal de ECHTE 'x' (de waarde) op uit de scope van de gebruiker
if (!exists(name_of_x, envir = parent.frame(), inherits = TRUE)) {
stop(paste("Fout: Variabele", name_of_x, "bestaat niet in de huidige scope."))
}
x_value <- get(name_of_x, envir = parent.frame())
# 3. Haal de replacement-functie op uit de proxy
real_fun <- attr(proxy_obj, "real_fun")
# 4. Filter de overige argumenten (alles behalve de var_name)
if ("x" %in% names(dots)) {
remaining_args <- dots[names(dots) != "x"]
} else {
remaining_args <- dots[-1]
}
# 5. Voer de logica uit
fun_args <- c(list(x_value), remaining_args, list(value = value))
updated_x <- do.call(real_fun, fun_args)
# 6. Schrijf de nieuwe waarde direct terug naar de gebruiker
assign(name_of_x, updated_x, envir = parent.frame())
# 7. Retourneer de proxy zelf om de functie in de env te beschermen
return(proxy_obj)
}
