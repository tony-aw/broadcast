library(squarebrackets)
x.dim <- c(500L, 500L, 50L)
x.len <- prod(x.dim) |> as.integer()
x <- array(1L:x.len, x.dim)
sub = n(1:900, 1:900, 1:40)
dims = 1:3
do_mod <- function(x, lst, value) {
eval(substitute(
do.call(
\(...){
x[...] <- value
},
lst
),
parent.frame(n = 1)
))
}
do_mod(x, ci_ss(x, sub, dims), -1)
aman <- function(x, sub, rp) {
x.dim <- dim(x)
x.ndim <- length(x.dim)
dim(x) <- c(dim(x), rep(1L, 4 - x.ndim))
sub <- c(sub, rep(list(1L), 4 - x.ndim))
x[sub[[1]], sub[[2]], sub[[3]], sub[[4]]] <- rp
dim(x) <- x.dim
return(x)
}
