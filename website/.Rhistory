# speed tests
library(broadcast)
# 32bit relops ====
n <- 300
print(n^3/1e6)
a <- array(sample(c(1:100, NA)), c(n, 1L, n, 1L))
b <- array(sample(c(1:100, NA)), c(1L, n, 1L, 1L))
prep <- broadcast:::.binary_prep(a, b)
gc()
foo <- bench::mark(
test_regular = broadcast:::.rcpp_bcRel_boolint_d(a, b, prep, 1L),
test_sw = broadcast:::.rcpp_bcRel_boolint_1v(a, b, prep, 1L),
min_iterations = 200,
min_time = 10
)
summary(foo)
