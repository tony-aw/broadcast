# speed tests
library(broadcast)
n <- 400L
print(n^3 / 1e6)
rt <- loadNamespace("reticulate")
np <- rt$import("numpy", convert = FALSE)
gc <- rt$import("gc", convert = FALSE)
gc$enable()
npa <- np$random$rand(n, n)
npb <- np$random$rand(n, 1L, n)
a <- array(rnorm(100), c(n, n))
b <- array(rnorm(100), c(n, 1L, n))
broadcaster(a) <- broadcaster(b) <- TRUE
gc()
foo <- bench::mark(
bc.d = bc.d(a, b, "+")
bc.op = a + b,
foo <- bench::mark(
bc.d = bc.d(a, b, "+"),
bc.op = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 100,
)
summary(foo)
ggplot2::autoplot(foo)
gc()
foo <- bench::mark(
# bc.d = bc.d(a, b, "+"),
bc.op = a + b,
numpy_via_reticulate = npa + npb,
check = FALSE,
min_iterations = 100,
)
