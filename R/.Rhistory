SEXP tempout;
SEXP tempstr;
SEXP out = PROTECT(Rf_allocVector(STRSXP, n));
SEXP *pout = STRING_PTR(out);
for(int i = 0; i < n; ++i) {
tempout = VECTOR_ELT(x, i);
if(TYPEOF(tempout) == OBJSXP && ! IS_S4_OBJECT(tempout)) {
tempstr = mkString(\"object\");
}
else {
tempstr = type2str(TYPEOF(tempout));
}
pout[i] = tempstr;
}
UNPROTECT(1);
return out;
"
