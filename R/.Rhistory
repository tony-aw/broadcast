//' @keywords internal
//' @noRd
// [[Rcpp::export(rcpp_mergedims_rng)]]
SEXP rcpp_mergedims_rng(
int start, int end
) {
int n = end - start + 1;
SEXP out = PROTECT(Rf_allocVector(INTSXP, n));
int *pout = INTEGER(out);
for(int i = 0; i < n; ++i) {
pout[i] = start + i;
}
UNPROTECT(1);
return out;
}
