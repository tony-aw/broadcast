my_completer_rstudio <- function(token, contextData, functionCallString, statementBounds,
chainObjectName, additionalArgs, excludeArgs,
excludeArgsFromObject, filePath, documentId, line, isConsole) {
res <- orig_fn(token, contextData, functionCallString, statementBounds,
chainObjectName, additionalArgs, excludeArgs,
excludeArgsFromObject, filePath, documentId, line, isConsole)
if (!isTRUE(.pkg_env$completer_active)) return(res)
# Reconstruct multi-line call up to cursor from contextData (which holds each nested call's text)
# Fallback to `line` if contextData is empty
code_context <- line
if (is.list(contextData) && length(contextData) > 0L) {
# contextData[[1L]][[1L]] is the innermost enclosing call text across lines
first_ctx <- contextData[[1L]]
if (is.list(first_ctx) && length(first_ctx) >= 1L && is.character(first_ctx[[1L]]) && nzchar(first_ctx[[1L]])) {
code_context <- first_ctx[[1L]]
}
}
if (!is.character(code_context) || length(code_context) != 1L || !nzchar(code_context)) {
return(res)
}
# Strip any auto-closed trailing parentheses RStudio may include after the cursor
code_context <- sub("\\)+\\s*$", "", code_context)
target_fun_names <- c("customfun", "otherfun")
col_res <- NULL
# 1. Try single-line context first
if (is.character(line) && length(line) == 1L && nzchar(line)) {
col_res <- get_formula_completions(line, target_fun_names)
}
# 2. Fallback for multi-line calls: stitch RStudio's `functionCallString` (fn + arg 1) with current `line`
if (is.null(col_res) &&
is.character(functionCallString) && length(functionCallString) == 1L && nzchar(functionCallString) &&
is.character(line) && length(line) == 1L && nzchar(line)) {
clean_call <- trimws(gsub("[\r\n]+", " ", functionCallString))
base_call  <- sub("\\)+$", "", clean_call)
stitched   <- paste0(base_call, ", ", trimws(line))
message("stitched = ", dQuote(stitched))
col_res    <- get_formula_completions(stitched, target_fun_names)
}
if (is.null(col_res) || length(col_res$comps) == 0L) return(res)
col_type <- tryCatch(as.integer(rs_env$.rs.acCompletionTypes$COLUMN), error = function(e) 0L)
if (length(col_type) != 1L || is.na(col_type)) col_type <- 0L
n_new <- length(col_res$comps)
n_old <- length(res$completions)
old_override <- if (length(res$overrideInsertParens) == n_old) res$overrideInsertParens else rep(FALSE, n_old)
res$token                <- col_res$last_word
res$completions          <- c(col_res$comps, res$completions)
if (!is.null(res$results)) {
res$results            <- c(col_res$comps, res$results)
}
res$packages             <- c(rep("", n_new), res$packages)
res$quote                <- c(rep(FALSE, n_new), res$quote)
res$type                 <- as.integer(c(rep(col_type, n_new), res$type))
res$overrideInsertParens <- c(rep(FALSE, n_new), old_override)
res$cacheable            <- structure(FALSE, class = "rs.scalar")
res
}
return(res)
