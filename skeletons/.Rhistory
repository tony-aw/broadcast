y
library(broadcast)
by_y <- broadcast:::.C_make_by(y)
by_y <- broadcast:::.C_make_by(dim(y))
dcp_y <- broadcast:::.C_make_dcp(dim(y))
.rcpp_bcConc_str_d(x, y, by_y, dcp_y, dim(x))
