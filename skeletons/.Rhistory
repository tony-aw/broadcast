x <- array(datax, c(1, n))
y <- array(datay, c(n, 1))
invisible(gc())
foo <- bench::mark(
bc.d(x, y, "+"),
rray_add(x, y),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
