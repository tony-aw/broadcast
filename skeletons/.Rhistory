disable_autocomplete_mypkg <- function() {
if (!interactive()) return(invisible(FALSE))
.pkg_env$completer_active <- FALSE
invisible(TRUE)
}
enable_autocomplete_rstudio() # run this or it won't work!
data(mtcars)
head(mtcars)
data(iris)
head(iris)
trace(".rs.rpc.get_completions", tracer = quote(message("HOOK FIRED! code_context = ", code_context)), where = as.environment("tools:rstudio"))
utils::rc.getOption("custom.completer")
body(as.environment("tools:rstudio")$.rs.rpc.get_completions)
customfun <- function(x, form) tinycodet::with_pro(x, form)
nullcoalesc <- function (x, y) if (is.null(x)) y else x
.pkg_env <- new.env(parent = emptyenv())
.pkg_env$completer_active <- FALSE
.pkg_env$completer_registered <- FALSE
.pkg_env$prev_completer <- NULL
# 1. Close unclosed parentheses and append dummy token for AST parsing
parse_incomplete <- function(line) {
candidate <- paste0(line, ".__dummy__")
opens <- lengths(regmatches(candidate, gregexpr("\\(", candidate)))
closes <- lengths(regmatches(candidate, gregexpr("\\)", candidate)))
if (opens > closes) {
candidate <- paste0(candidate, strrep(")", opens - closes))
}
tryCatch(str2lang(candidate), error = function(e) NULL)
}
# 2. Find the innermost function call containing `.__dummy__` (stopping at `~`)
find_target_call <- function(expr) {
if (!is.call(expr)) return(NULL)
if (identical(.subset2(expr, 1L), as.name("~"))) return(NULL)
for (arg in as.list(expr)[-1]) {
deeper <- find_target_call(arg)
if (!is.null(deeper)) return(deeper)
}
if (".__dummy__" %in% all.vars(expr)) expr else NULL
}
# 3. Verify that the call head resolves to one of your package's functions
is_target_pkg_fun <- function(call_head, target_fun_names) {
if (is.call(call_head)) {
op <- as.character(.subset2(call_head, 1L))
if (length(op) != 1L || !(op %in% c("::", ":::", "$", "[["))) return(FALSE)
} else if (!is.symbol(call_head)) {
return(FALSE)
}
fn <- tryCatch(eval(call_head, envir = .GlobalEnv), error = function(e) NULL)
if (!is.function(fn)) return(FALSE)
target_env <- topenv(environment())
if (!identical(environment(fn), target_env)) return(FALSE)
any(vapply(target_fun_names, function(fn_name) {
exists(fn_name, envir = target_env, inherits = FALSE) &&
identical(fn, get(fn_name, envir = target_env, inherits = FALSE))
}, logical(1L)))
}
# 4. Extract matching column names from the data frame passed in arg 1
match_df_columns <- function(data_expr, last_word) {
if (!is.symbol(data_expr)) return(character(0))
df_name <- as.character(data_expr)
if (!exists(df_name, envir = .GlobalEnv)) return(character(0))
df <- get(df_name, envir = .GlobalEnv)
if (!is.data.frame(df)) return(character(0))
cols <- names(df)
cols[startsWith(cols, last_word)]
}
# 5. Orchestrate AST lookup and return matched completions (or NULL)
get_formula_completions <- function(line, target_fun_names) {
# ignore namespaces:
if (grepl(":{2,3}[[:alnum:]._]*$", line)) return(NULL)
last_word <- stringi::stri_extract_last_regex(line, "[[:alnum:]._]+$")
if (is.na(last_word)) last_word <- ""
base_line <- substr(line, 1L, nchar(line) - nchar(last_word))
ast <- parse_incomplete(base_line)
target_call <- find_target_call(ast)
if (is.null(target_call) || length(target_call) < 3L) return(NULL)
if (!is_target_pkg_fun(.subset2(target_call, 1L), target_fun_names)) return(NULL)
form_expr <- .subset2(target_call, 3L)
is_dummy_formula <- is.call(form_expr) &&
identical(.subset2(form_expr, 1L), as.name("~")) &&
".__dummy__" %in% all.vars(form_expr)
if (!is_dummy_formula) return(NULL)
matched <- match_df_columns(.subset2(target_call, 2L), last_word)
if (length(matched) == 0L) return(NULL)
list(last_word = last_word, comps = matched)
}
# Top-level completer hook registered once with rc.options()
my_completer <- function(x) {
prev_completer <- .pkg_env$prev_completer
# 1. Run any previously registered completer (or R's default completer)
current_completer <- utils::rc.getOption("custom.completer")
utils::rc.options(custom.completer = prev_completer)
on.exit(utils::rc.options(custom.completer = current_completer), add = TRUE)
default_complete <- utils::getFromNamespace(".completeToken", "utils")
default_complete()
# 2. Only add your package's completions if currently enabled
if (isTRUE(.pkg_env$completer_active)) {
target_fun_names <- c("customfun", "otherfun")
comp_env <- utils::getFromNamespace(".CompletionEnv", "utils")
line <- substr(comp_env$linebuffer, 1L, comp_env$end)
res <- get_formula_completions(line, target_fun_names)
if (!is.null(res)) {
# Only keep default completions if start position did not change
new_start <- comp_env$end - nchar(res$last_word)
if (identical(comp_env$start, new_start)) {
comp_env$comps <- unique(c(res$comps, comp_env$comps))
} else {
comp_env$start <- new_start
comp_env$token <- res$last_word
comp_env$comps <- res$comps
}
}
}
invisible(NULL)
}
enable_autocomplete_rstudio <- function() {
rs_env <- as.environment("tools:rstudio")
if (is.null(.pkg_env$orig_rs_get_completions)) {
.pkg_env$orig_rs_get_completions <- get(".rs.rpc.get_completions", envir = rs_env)
}
.pkg_env$completer_active <- TRUE
orig_fn <- .pkg_env$orig_rs_get_completions
wrapped_fn <- function(token, contextData, functionCallString, statementBounds,
chainObjectName, additionalArgs, excludeArgs,
excludeArgsFromObject, filePath, documentId, line, isConsole) {
message(
"line = ", dQuote(line),
"\nfunctionCallString = ", paste(dQuote(functionCallString), collapse = ", "),
"\ncontextData = ", paste(utils::capture.output(utils::str(contextData)), collapse = "\n")
)
res <- orig_fn(token, contextData, functionCallString, statementBounds,
chainObjectName, additionalArgs, excludeArgs,
excludeArgsFromObject, filePath, documentId, line, isConsole)
if (!isTRUE(.pkg_env$completer_active)) return(res)
# Reconstruct multi-line call up to cursor from contextData (which holds each nested call's text)
# Fallback to `line` if contextData is empty
code_context <- line
if (is.list(contextData) && length(contextData) > 0L) {
# contextData[[1L]][[1L]] is the innermost enclosing call text across lines
first_ctx <- contextData[[1L]]
if (is.list(first_ctx) && length(first_ctx) >= 1L && is.character(first_ctx[[1L]]) && nzchar(first_ctx[[1L]])) {
code_context <- first_ctx[[1L]]
}
}
if (!is.character(code_context) || length(code_context) != 1L || !nzchar(code_context)) {
return(res)
}
# Strip any auto-closed trailing parentheses RStudio may include after the cursor
code_context <- sub("\\)+\\s*$", "", code_context)
target_fun_names <- c("customfun", "otherfun")
col_res <- NULL
# 1. Try single-line context first
if (is.character(line) && length(line) == 1L && nzchar(line)) {
col_res <- get_formula_completions(line, target_fun_names)
}
# 2. Fallback for multi-line calls: stitch RStudio's `functionCallString` (fn + arg 1) with current `line`
if (is.null(col_res) &&
is.character(functionCallString) && length(functionCallString) == 1L && nzchar(functionCallString) &&
is.character(line) && length(line) == 1L && nzchar(line)) {
clean_call <- trimws(gsub("[\r\n]+", " ", functionCallString))
base_call  <- sub("\\)+$", "", clean_call)
stitched   <- paste0(base_call, ", ", trimws(line))
col_res    <- get_formula_completions(stitched, target_fun_names)
}
if (is.null(col_res) || length(col_res$comps) == 0L) return(res)
col_type <- tryCatch(as.integer(rs_env$.rs.acCompletionTypes$COLUMN), error = function(e) 0L)
if (length(col_type) != 1L || is.na(col_type)) col_type <- 0L
n_new <- length(col_res$comps)
n_old <- length(res$completions)
old_override <- if (length(res$overrideInsertParens) == n_old) res$overrideInsertParens else rep(FALSE, n_old)
res$token                <- col_res$last_word
res$completions          <- c(col_res$comps, res$completions)
if (!is.null(res$results)) {
res$results            <- c(col_res$comps, res$results)
}
res$packages             <- c(rep("", n_new), res$packages)
res$quote                <- c(rep(FALSE, n_new), res$quote)
res$type                 <- as.integer(c(rep(col_type, n_new), res$type))
res$overrideInsertParens <- c(rep(FALSE, n_new), old_override)
res$cacheable            <- structure(FALSE, class = "rs.scalar")
res
}
ub <- get("unlockBinding", envir = baseenv())
lb <- get("lockBinding", envir = baseenv())
ub(".rs.rpc.get_completions", rs_env)
assign(".rs.rpc.get_completions", wrapped_fn, envir = rs_env)
lb(".rs.rpc.get_completions", rs_env)
invisible(TRUE)
}
#' Enable formula column autocompletion in RStudio
#' @export
enable_autocomplete_mypkg <- function() {
if (!interactive()) return(invisible(FALSE))
# Register with rc.options() only once per R session
if (!isTRUE(.pkg_env$completer_registered)) {
.pkg_env$prev_completer <- utils::rc.getOption("custom.completer")
utils::rc.options(custom.completer = my_completer)
.pkg_env$completer_registered <- TRUE
}
.pkg_env$completer_active <- TRUE
invisible(TRUE)
}
#' Disable formula column autocompletion in RStudio
#' @export
disable_autocomplete_mypkg <- function() {
if (!interactive()) return(invisible(FALSE))
.pkg_env$completer_active <- FALSE
invisible(TRUE)
}
enable_autocomplete_rstudio() # run this or it won't work!
