datay <- sample(c(1:100, NA))
# Vector ====
n <- 1e7
x <- array(datax, n)
y <- array(datay, n)
invisible(gc())
foo <- bench::mark(
bc.d(x, y, "+"),
rray_add(x, y),
min_iterations = 500,
min_time = 10
)
summary(foo)
plot(foo)
invisible(gc())
